@code {

    // ============================================================
    // GitHub Pages Base URL Helper
    // ============================================================

    private string AppUrl(string path)
    {
        return $"{Navigation.BaseUri.TrimEnd('/')}/{path.TrimStart('/')}";
    }


    // ============================================================
    // Language UI Update
    // ============================================================

    private void UpdateUI()
    {
        InvokeAsync(StateHasChanged);
    }


    protected override void OnInitialized()
    {
        LangService.OnLanguageChanged += UpdateUI;
    }


    // ============================================================
    // Dispose
    // ============================================================

    public void Dispose()
    {
        LangService.OnLanguageChanged -= UpdateUI;
    }

}
