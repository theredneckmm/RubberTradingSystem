@using MudBlazor
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject LanguageService LangService
@implements IDisposable

<MudDialog>
    <DialogContent>
        <EditForm Model="@Model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="Model.full_name"
                          Label="@LangService.GetString("Emp_NameLabel")"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Required="true" />

            <MudTextField @bind-Value="Model.position"
                          Label="@LangService.GetString("Emp_PositionLabel")"
                          Variant="Variant.Outlined"
                          Class="mb-4" />

            <MudNumericField @bind-Value="Model.salary"
                             Label="@LangService.GetString("Emp_SalaryLabel")"
                             Variant="Variant.Outlined"
                             Class="mb-4"
                             Min="0" />

            <MudTextField @bind-Value="Model.phone"
                          Label="@LangService.GetString("Emp_PhoneLabel")"
                          Variant="Variant.Outlined"
                          Class="mb-4" />

            <MudTextField @bind-Value="Model.address"
                          Label="@LangService.GetString("Emp_AddressLabel")"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Class="mb-4" />

            <MudDatePicker @bind-Date="_hireDate"
                           Label="@LangService.GetString("Emp_DateLabel")"
                           Variant="Variant.Outlined"
                           Class="mb-4" />

            <MudSelect T="string" @bind-Value="Model.status"
                       Label="@LangService.GetString("Emp_StatusLabel")"
                       Variant="Variant.Outlined"
                       Class="mb-4"
                       Required="true">
                <MudSelectItem Value="@("Active")">Active (အလုပ်လုပ်ဆဲ)</MudSelectItem>
                <MudSelectItem Value="@("Resigned")">Resigned (နုတ်ထွက်ပြီး)</MudSelectItem>
            </MudSelect>

            <div class="d-flex justify-end">
                <MudButton OnClick="Cancel" Variant="Variant.Text" Class="mr-2">
                    @LangService.GetString("Rubber_Cancel")
                </MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                    @(IsNew ? LangService.GetString("Rubber_Save") : LangService.GetString("Rubber_Update"))
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public EmployeeModel Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private DateTime? _hireDate
    {
        get => Model.hire_date;
        set => Model.hire_date = value ?? DateTime.Today;
    }

    protected override void OnInitialized() => LangService.OnLanguageChanged += StateHasChanged;
    public void Dispose() => LangService.OnLanguageChanged -= StateHasChanged;

    private async Task SaveAsync()
    {
        try
        {
            if (IsNew)
            {
                var response = await Http.PostAsJsonAsync("rest/v1/employees", Model);
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add(LangService.GetString("Emp_SaveSuccess"), Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else Snackbar.Add("Failed to save employee.", Severity.Error);
            }
            else
            {
                var response = await Http.PatchAsync($"rest/v1/employees?id=eq.{Model.id}", JsonContent.Create(new
                {
                    full_name = Model.full_name,
                    position = Model.position,
                    salary = Model.salary,
                    phone = Model.phone,
                    address = Model.address,
                    hire_date = Model.hire_date,
                    status = Model.status
                }));
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add(LangService.GetString("Emp_UpdateSuccess"), Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else Snackbar.Add("Failed to update employee.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}