@page "/daily-prices"
@using MudBlazor
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject LanguageService LangService
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">@LangService.GetString("Price_ListTitle")</MudText>

    <MudTable Items="@_items"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="new Func<DailyPriceModel,bool>(FilterFunc)"
              @bind-SelectedItem="_selectedItem"
              RowStyleFunc="@SelectedRowStyle"
              RowClass="cursor-pointer"
              Elevation="2">

        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString"
                          Placeholder="@LangService.GetString("Price_SearchPlaceholder")"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-0"
                          Clearable="true">
            </MudTextField>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>@LangService.GetString("Price_ColType")</MudTh>
            <MudTh>@LangService.GetString("Price_ColPrice")</MudTh>
            <MudTh>@LangService.GetString("Price_ColDate")</MudTh>
        </HeaderContent>

        <RowTemplate>
            <!-- 👈 ID အစား အမည် (Name) နှင့် Grade ကို ပေါ်စေခြင်း -->
            <MudTd DataLabel="Type">
                <MudChip T="string" Color="Color.Secondary" Size="Size.Small">
                    @(context.rubber_types != null ? $"{context.rubber_types.name} ({context.rubber_types.grade})" : "N/A")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Price"><b>@context.price_per_unit.ToString("N0")</b></MudTd>
            <MudTd DataLabel="Date">@context.effective_date.ToString("dd/MM/yyyy")</MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>

    <MudPaper Class="d-flex justify-end pa-4 mt-4" Elevation="2">
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog" Class="mr-2">
            @LangService.GetString("Price_AddButton")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit"
                   Disabled="@(_selectedItem == null)" OnClick="OpenEditDialog" Class="mr-2">
            @LangService.GetString("Price_EditButton")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                   Disabled="@(_selectedItem == null)" OnClick="DeleteAsync">
            @LangService.GetString("Price_DeleteButton")
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private List<DailyPriceModel> _items = new();
    private DailyPriceModel? _selectedItem;
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += StateHasChanged;
        await LoadDataAsync();
    }

    public void Dispose() => LangService.OnLanguageChanged -= StateHasChanged;

    private async Task LoadDataAsync()
    {
        try
        {
            // 👈 Foreign Key Join ဖြင့် rubber_types ဇယားမှ name နှင့် grade ပါ တစ်ခါတည်း ဆွဲထုတ်ခြင်း
            _items = await Http.GetFromJsonAsync<List<DailyPriceModel>>("rest/v1/daily_prices?select=*,rubber_types(name,grade)&order=effective_date.desc") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private bool FilterFunc(DailyPriceModel item)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        // အမည်ဖြင့် ရှာဖွေနိုင်ရန်
        if (item.rubber_types != null && item.rubber_types.name.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private string SelectedRowStyle(DailyPriceModel item, int rowNumber)
    {
        if (_selectedItem != null && _selectedItem.id == item.id)
        {
            return "background-color: #4477FF !important;";
        }
        return string.Empty;
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters { ["Model"] = new DailyPriceModel(), ["IsNew"] = true };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<DailyPriceDialog>(LangService.GetString("Price_AddTitle"), parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled) await LoadDataAsync();
    }

    private async Task OpenEditDialog()
    {
        if (_selectedItem == null) return;
        var editModel = new DailyPriceModel
        {
            id = _selectedItem.id,
            owner_id = _selectedItem.owner_id,
            staff_id = _selectedItem.staff_id,
            rubber_type_id = _selectedItem.rubber_type_id,
            price_per_unit = _selectedItem.price_per_unit,
            effective_date = _selectedItem.effective_date
        };

        var parameters = new DialogParameters { ["Model"] = editModel, ["IsNew"] = false };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<DailyPriceDialog>(LangService.GetString("Price_EditTitle"), parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled) await LoadDataAsync();
    }

    private async Task DeleteAsync()
    {
        if (_selectedItem == null) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm",
            LangService.GetString("Price_DeleteConfirm"),
            yesText: "Yes", cancelText: "Cancel");

        if (confirmed == true)
        {
            var response = await Http.DeleteAsync($"rest/v1/daily_prices?id=eq.{_selectedItem.id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(LangService.GetString("Price_DeleteSuccess"), Severity.Success);
                await LoadDataAsync();
                _selectedItem = null;
            }
            else
            {
                Snackbar.Add("Failed to delete price.", Severity.Error);
            }
        }
    }
}