@using Microsoft.AspNetCore.Components
@using MudBlazor

<MudDialog>
    <DialogContent>
        <div class="d-flex flex-column align-center mb-4">
            <MudAvatar Color="Color.Primary" Size="Size.Large" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" />
            </MudAvatar>
            <MudText Typo="Typo.h6"><b>@(string.IsNullOrEmpty(FullName) ? "User Profile" : FullName)</b></MudText>
            <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="mt-1">@Role</MudChip>
        </div>

        <MudList T="string">
            <MudListItem Icon="@Icons.Material.Filled.Email">
                <ChildContent>
                    <MudText Typo="Typo.body2"><b>Email:</b> @Email</MudText>
                </ChildContent>
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Badge">
                <ChildContent>
                    <MudText Typo="Typo.body2"><b>Role / Access Level:</b> @Role</MudText>
                </ChildContent>
            </MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">ပိတ်မည်</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Email { get; set; } = string.Empty;
    [Parameter] public string FullName { get; set; } = string.Empty;
    [Parameter] public string Role { get; set; } = string.Empty;

    private void Close() => MudDialog.Close();
}