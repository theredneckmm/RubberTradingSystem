@page "/contacts/edit/{Id}"
@using MudBlazor
@using RubberTradingSystem.Models
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject RubberTradingSystem.Services.LanguageService Lang
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-6 fw-bold">@Lang.GetString("Title_EditContact")</MudText>

        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
        }
        else
        {
            <MudForm @ref="_form" @bind-IsValid="@_success">
                <MudGrid>
                    <!-- အမည် -->
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_contact.Name" Label="@Lang.GetString("Lbl_Name")"
                                      Required="true" RequiredError="@Lang.GetString("Err_NameRequired")" Variant="Variant.Outlined" />
                    </MudItem>

                    <!-- ဖုန်းနံပါတ် -->
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_contact.Phone" Label="@Lang.GetString("Lbl_Phone")" Variant="Variant.Outlined" />
                    </MudItem>

                    <!-- အမျိုးအစား -->
                    <MudItem xs="12" sm="6">
                        <MudSelect @bind-Value="_contact.ContactType" Label="@Lang.GetString("Lbl_ContactType")" Required="true" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Supplier")">@Lang.GetString("Opt_Supplier")</MudSelectItem>
                            <MudSelectItem Value="@("Buyer")">@Lang.GetString("Opt_Buyer")</MudSelectItem>
                            <MudSelectItem Value="@("General")">@Lang.GetString("Opt_General")</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <!-- ဘဏ်အချက်အလက် -->
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_contact.BankInfo" Label="@Lang.GetString("Lbl_BankInfo")" Variant="Variant.Outlined" />
                    </MudItem>

                    <!-- လိပ်စာ -->
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_contact.Address" Label="@Lang.GetString("Lbl_Address")" Variant="Variant.Outlined" Lines="2" />
                    </MudItem>
                </MudGrid>

                <!-- ခလုတ်များ -->
                <div class="d-flex justify-end mt-6">
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Href="/contacts" Class="mr-3">
                        @Lang.GetString("Btn_Back")
                    </MudButton>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_success || _isSaving)" OnClick="UpdateContactAsync">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">@Lang.GetString("Btn_Saving")</MudText>
                        }
                        else
                        {
                            <MudText>@Lang.GetString("Btn_SaveChanges")</MudText>
                        }
                    </MudButton>
                </div>
            </MudForm>
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private MudForm _form = new();
    private bool _success;
    private bool _isLoading = true;
    private bool _isSaving;
    private Contact _contact = new();

    protected override async Task OnInitializedAsync()
    {
        Lang.OnLanguageChanged += StateHasChanged;
        await LoadContactDataAsync();
    }

    private async Task LoadContactDataAsync()
    {
        _isLoading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<Contact>>($"rest/v1/contacts?id=eq.{Id}&select=*");
            if (result != null && result.Count > 0)
            {
                _contact = result[0];
            }
            else
            {
                Snackbar.Add(Lang.GetString("Msg_NotFound"), Severity.Warning);
                Navigation.NavigateTo("/contacts");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Lang.GetString("Msg_Error")}{ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task UpdateContactAsync()
    {
        await _form.Validate();
        if (!_success) return;

        _isSaving = true;
        try
        {
            var response = await Http.PatchAsJsonAsync($"rest/v1/contacts?id=eq.{Id}", _contact);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(Lang.GetString("Msg_UpdateSuccess"), Severity.Success);
                Navigation.NavigateTo("/contacts");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"{Lang.GetString("Msg_Error")}{error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Lang.GetString("Msg_Error")}{ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}