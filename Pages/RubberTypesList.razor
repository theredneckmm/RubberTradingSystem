@page "/rubber-types"
@using MudBlazor
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject LanguageService LangService
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">@LangService.GetString("Rubber_ListTitle")</MudText>

    <MudTable Items="@_items"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="new Func<RubberTypeModel,bool>(FilterFunc)"
              @bind-SelectedItem="_selectedItem"
              RowStyleFunc="@SelectedRowStyle"
              RowClass="cursor-pointer"
              Elevation="2">

        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString"
                          Placeholder="@LangService.GetString("Rubber_SearchPlaceholder")"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-0"
                          Clearable="true">
            </MudTextField>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>@LangService.GetString("Rubber_ColName")</MudTh>
            <MudTh>@LangService.GetString("Rubber_ColGrade")</MudTh>
            <MudTh>@LangService.GetString("Rubber_ColDesc")</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Name"><b>@context.name</b></MudTd>
            <MudTd DataLabel="Grade">
                <MudChip T="string" Color="Color.Success" Size="Size.Small">@context.grade</MudChip>
            </MudTd>
            <MudTd DataLabel="Description">@context.description</MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>

    <MudPaper Class="d-flex justify-end pa-4 mt-4" Elevation="2">
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog" Class="mr-2">
            @LangService.GetString("Rubber_AddButton")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit"
                   Disabled="@(_selectedItem == null)" OnClick="OpenEditDialog" Class="mr-2">
            @LangService.GetString("Rubber_EditButton")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                   Disabled="@(_selectedItem == null)" OnClick="DeleteAsync">
            @LangService.GetString("Rubber_DeleteButton")
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private List<RubberTypeModel> _items = new();
    private RubberTypeModel? _selectedItem;
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += StateHasChanged;
        await LoadDataAsync();
    }

    public void Dispose() => LangService.OnLanguageChanged -= StateHasChanged;

    private async Task LoadDataAsync()
    {
        try
        {
            _items = await Http.GetFromJsonAsync<List<RubberTypeModel>>("rest/v1/rubber_types?select=*&order=created_at.desc") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private bool FilterFunc(RubberTypeModel item)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        return item.name.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
               item.grade.Contains(_searchString, StringComparison.OrdinalIgnoreCase);
    }

    // 👈 Select မှတ်ထားသော Row အတွက် အရောင်ပြောင်းပေးမည့် Function
    private string SelectedRowStyle(RubberTypeModel item, int rowNumber)
    {
        if (_selectedItem != null && _selectedItem.id == item.id)
        {
            return "background-color: #4477FF !important;";
        }
        return string.Empty;
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters { ["Model"] = new RubberTypeModel(), ["IsNew"] = true };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RubberTypeDialog>(LangService.GetString("Rubber_AddTitle"), parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled) await LoadDataAsync();
    }

    private async Task OpenEditDialog()
    {
        if (_selectedItem == null) return;

        var editModel = new RubberTypeModel
        {
            id = _selectedItem.id,
            owner_id = _selectedItem.owner_id,
            staff_id = _selectedItem.staff_id,
            name = _selectedItem.name,
            grade = _selectedItem.grade,
            description = _selectedItem.description
        };

        var parameters = new DialogParameters { ["Model"] = editModel, ["IsNew"] = false };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RubberTypeDialog>(LangService.GetString("Rubber_EditTitle"), parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled) await LoadDataAsync();
    }

    private async Task DeleteAsync()
    {
        if (_selectedItem == null) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm",
            LangService.GetString("Rubber_DeleteConfirm"),
            yesText: "Yes", cancelText: "Cancel");

        if (confirmed == true)
        {
            var response = await Http.DeleteAsync($"rest/v1/rubber_types?id=eq.{_selectedItem.id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(LangService.GetString("Rubber_DeleteSuccess"), Severity.Success);
                await LoadDataAsync();
                _selectedItem = null;
            }
            else
            {
                Snackbar.Add("Failed to delete.", Severity.Error);
            }
        }
    }
}