@page "/contacts/balance"
@using MudBlazor
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject LanguageService Lang
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4 fw-bold">
        @Lang.GetString("Title_BalanceSummary")
    </MudText>

    <!-- Summary Cards -->
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="pa-4" Style="border-left: 6px solid var(--mud-palette-error);">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@Lang.GetString("Card_TotalAdvanceOut")</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Error" Class="fw-bold mt-1">
                        @_totalAdvanceBalance.ToString("N2") MMK
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="pa-4" Style="border-left: 6px solid var(--mud-palette-success);">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@Lang.GetString("Card_TotalReceivable")</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Success" Class="fw-bold mt-1">
                        @_totalReceivableBalance.ToString("N2") MMK
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Tabs ထဲတွင် ခွဲထုတ်ထားသော Component ကို ခေါ်သုံးပုံ -->
    <MudPaper Elevation="2" Class="pa-4">
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" @bind-ActiveIndex="_activeTab">

            <!-- ခြံရှင်များ Tab -->
            <MudTabPanel Text="@Lang.GetString("Tab_Suppliers")" Icon="@Icons.Material.Filled.Agriculture">
                <ContactsTable Items="_suppliers" Lang="Lang" />
            </MudTabPanel>

            <!-- ကုန်သည်များ Tab -->
            <MudTabPanel Text="@Lang.GetString("Tab_Buyers")" Icon="@Icons.Material.Filled.Storefront">
                <ContactsTable Items="_buyers" Lang="Lang" />
            </MudTabPanel>

            <!-- အားလုံး Tab -->
            <MudTabPanel Text="@Lang.GetString("Tab_AllContacts")" Icon="@Icons.Material.Filled.People">
                <ContactsTable Items="_allContacts" Lang="Lang" />
            </MudTabPanel>

        </MudTabs>
    </MudPaper>
</MudContainer>

@code {
    private List<Contact> _allContacts = new();
    private List<Contact> _suppliers = new();
    private List<Contact> _buyers = new();
    private int _activeTab = 0;

    private decimal _totalAdvanceBalance => _suppliers.Sum(c => c.AdvanceBalance);
    private decimal _totalReceivableBalance => _buyers.Sum(c => c.ReceivableBalance);

    protected override async Task OnInitializedAsync()
    {
        Lang.OnLanguageChanged += StateHasChanged;
        await LoadContactsAsync();
    }

    public void Dispose() => Lang.OnLanguageChanged -= StateHasChanged;

    private async Task LoadContactsAsync()
    {
        try
        {
            _allContacts = await Http.GetFromJsonAsync<List<Contact>>("rest/v1/contacts?select=*&order=name.asc") ?? new();
            _suppliers = _allContacts.Where(c => c.ContactType == "Supplier").ToList();
            _buyers = _allContacts.Where(c => c.ContactType == "Buyer").ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"ဒေတာဆွဲယူရာတွင် အမှားရှိသည်: {ex.Message}", Severity.Error);
        }
    }
}