@using MudBlazor
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject LanguageService LangService
@implements IDisposable

<MudDialog>
    <DialogContent>
        <EditForm Model="@Model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.invoice_no"
                                  Label="@LangService.GetString("Sale_InvoiceLabel")"
                                  Variant="Variant.Outlined"
                                  Class="mb-4"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.customer_name"
                                  Label="@LangService.GetString("Sale_CustomerLabel")"
                                  Variant="Variant.Outlined"
                                  Class="mb-4"
                                  Required="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="Model.warehouse_name"
                               Label="@LangService.GetString("Sale_WarehouseLabel")"
                               Variant="Variant.Outlined"
                               Class="mb-4"
                               Required="true">
                        @foreach (var wh in _warehouseList)
                        {
                            <MudSelectItem Value="@wh">@wh</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="Model.rubber_type"
                               Label="@LangService.GetString("Sale_TypeLabel")"
                               Variant="Variant.Outlined"
                               Class="mb-4"
                               Required="true">
                        @foreach (var type in _rubberTypeList)
                        {
                            <MudSelectItem Value="@type">@type</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="Model.weight_kg"
                                     Label="@LangService.GetString("Sale_WeightLabel")"
                                     Variant="Variant.Outlined"
                                     Class="mb-4"
                                     Min="0"
                                     Required="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="Model.price_per_kg"
                                     Label="@LangService.GetString("Sale_PriceLabel")"
                                     Variant="Variant.Outlined"
                                     Class="mb-4"
                                     Min="0"
                                     Required="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <!-- Total Amount (Auto calculated readonly display) -->
                    <MudTextField Value="@Model.total_amount.ToString("N0")"
                                  Label="@LangService.GetString("Sale_TotalLabel")"
                                  Variant="Variant.Outlined"
                                  Class="mb-4"
                                  ReadOnly="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="Model.payment_method"
                               Label="@LangService.GetString("Expense_PaymentMethodLabel")"
                               Variant="Variant.Outlined"
                               Class="mb-4"
                               Required="true">
                        <MudSelectItem Value="@("Cash")">@LangService.GetString("Income_Cash")</MudSelectItem>
                        @foreach (var method in _paymentMethods)
                        {
                            <MudSelectItem Value="@method">@method</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudDatePicker @bind-Date="_saleDate"
                                   Label="@LangService.GetString("Income_DateLabel")"
                                   Variant="Variant.Outlined"
                                   Class="mb-4" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.note"
                                  Label="@LangService.GetString("Income_NoteLabel")"
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  Class="mb-4" />
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-end mt-2">
                <MudButton OnClick="Cancel" Variant="Variant.Text" Class="mr-2">
                    @LangService.GetString("Rubber_Cancel")
                </MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                    @(IsNew ? LangService.GetString("Rubber_Save") : LangService.GetString("Rubber_Update"))
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public RubberSaleModel Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private List<string> _warehouseList = new();
    private List<string> _rubberTypeList = new();
    private List<string> _paymentMethods = new();

    private DateTime? _saleDate
    {
        get => Model.sale_date;
        set => Model.sale_date = value ?? DateTime.Today;
    }

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += StateHasChanged;
        await LoadDropdownsAsync();
    }

    public void Dispose() => LangService.OnLanguageChanged -= StateHasChanged;

    private async Task LoadDropdownsAsync()
    {
        try
        {
            // ဂိုဒေါင်စာရင်းများ
            var warehouses = await Http.GetFromJsonAsync<List<WarehouseModel>>("rest/v1/warehouses?select=warehouse_name");
            if (warehouses != null) _warehouseList = warehouses.Select(x => x.warehouse_name).ToList();

            // ရာဘာအမျိုးအစားများ
            var types = await Http.GetFromJsonAsync<List<RubberTypeModel>>("rest/v1/rubber_types?select=grade");
            if (types != null) _rubberTypeList = types.Select(x => x.grade).ToList();

            // ငွေပေးချေမှု နည်းလမ်းများ
            var methods = await Http.GetFromJsonAsync<List<PaymentMethodModel>>("rest/v1/payment_methods?select=name");
            if (methods != null) _paymentMethods = methods.Select(x => x.name).ToList();
        }
        catch { }
    }

    private async Task SaveAsync()
    {
        try
        {
            if (IsNew)
            {
                var response = await Http.PostAsJsonAsync("rest/v1/rubber_sales", Model);
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add(LangService.GetString("Sale_SaveSuccess"), Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else Snackbar.Add("Failed to save rubber sale.", Severity.Error);
            }
            else
            {
                var response = await Http.PatchAsync($"rest/v1/rubber_sales?id=eq.{Model.id}", JsonContent.Create(new
                {
                    invoice_no = Model.invoice_no,
                    customer_name = Model.customer_name,
                    warehouse_name = Model.warehouse_name,
                    rubber_type = Model.rubber_type,
                    weight_kg = Model.weight_kg,
                    price_per_kg = Model.price_per_kg,
                    total_amount = Model.total_amount,
                    payment_method = Model.payment_method,
                    sale_date = Model.sale_date,
                    note = Model.note
                }));
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add(LangService.GetString("Sale_UpdateSuccess"), Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else Snackbar.Add("Failed to update rubber sale.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}