@using RubberTradingSystem.Models.Printing
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <!-- Style များကို ဒီ div ထဲသို့ ရွှေ့ပြောင်းထားသည် -->
        <div style="overflow-y: auto; max-height: 75vh; padding: 16px; background-color: #334155; display: flex; justify-content: center;">

            <!-- Printable Area -->
            <div id="printable-voucher-area" class="voucher-paper">

                <div>
                    <!-- Header (Center Aligned) -->
                    <div class="voucher-header">
                        <div class="voucher-title">@Document.HeaderTitle</div>
                        <div class="voucher-address">@Document.HeaderAddress</div>
                        <div class="voucher-header-line"></div>
                    </div>

                    <!-- Meta Information Fields -->
                    <div class="voucher-meta" style="margin-bottom: 12px;">
                        @foreach (var field in Document.Fields)
                        {
                            <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 13px;">
                                <span><strong>@field.Label :</strong></span>
                                <span>@field.Value</span>
                            </div>
                        }
                    </div>

                    <!-- Rows Table -->
                    @if (Document.Rows != null && Document.Rows.Any())
                    {
                        <table class="voucher-table" style="width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 12px;">
                            <thead>
                                <tr>
                                    <th style="border-top: 1px solid #000; border-bottom: 2px solid #000; padding: 6px; text-align: left;">အကြောင်းအရာ</th>
                                    <th style="border-top: 1px solid #000; border-bottom: 2px solid #000; padding: 6px; text-align: right;">အရေအတွက်</th>
                                    <th style="border-top: 1px solid #000; border-bottom: 2px solid #000; padding: 6px; text-align: right;">ဈေးနှုန်း</th>
                                    <th style="border-top: 1px solid #000; border-bottom: 2px solid #000; padding: 6px; text-align: right;">စုစုပေါင်း</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Document.Rows)
                                {
                                    <tr>
                                        <td style="border-bottom: 1px solid #ddd; padding: 6px;">@row.Description</td>
                                        <td style="border-bottom: 1px solid #ddd; padding: 6px; text-align: right;">@row.Quantity.ToString("N2")</td>
                                        <td style="border-bottom: 1px solid #ddd; padding: 6px; text-align: right;">@row.Price.ToString("N0")</td>
                                        <td style="border-bottom: 1px solid #ddd; padding: 6px; text-align: right;">@row.Amount.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div style="text-align: right; font-weight: bold; font-size: 13px; margin-bottom: 15px;">
                            စုစုပေါင်းငွေ: @Document.Rows.Sum(x => x.Amount).ToString("N0") ကျပ်
                        </div>
                    }
                </div>

                <!-- Footer (Always sticky to bottom of the paper) -->
                <div class="voucher-footer">
                    <div style="border-top: 1px dashed #777; margin-bottom: 8px; width: 100%;"></div>
                    <p style="margin: 0; font-size: 12px; color: #333;">@Document.FooterNote</p>
                </div>

            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <!-- Style များကို ဒီ div ထဲသို့ ရွှေ့ပြောင်းထားသည် -->
        <div style="background-color: #1e293b; padding: 12px 16px; border-top: 1px solid #475569; width: 100%; display: flex; justify-content: flex-end; gap: 8px;">
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Close" Style="color: white;">ပိတ်မည်</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintVoucher">
                ပုံနှိပ်မည် (PRINT)
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

<style>
    /* CSS for Exact Paper Dimensions & Sticky Footer */
    .voucher-paper {
        width: @(Document.CustomWidth) mm;
        height: @(Document.CustomHeight) mm;
        min-height: @(Document.CustomHeight) mm;
        max-height: @(Document.CustomHeight) mm;
        background: white;
        color: black;
        padding: 8mm;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
    }

    .voucher-header {
        text-align: center;
        margin-bottom: 10px;
    }

    .voucher-title {
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 2px;
    }

    .voucher-address {
        font-size: 11px;
        color: #444;
        white-space: pre-line;
    }

    .voucher-header-line {
        border-bottom: 2px solid #000;
        margin-top: 6px;
        margin-bottom: 10px;
    }

    .voucher-footer {
        text-align: center;
        margin-top: auto;
    }
</style>

@code {
    [CascadingParameter]
    // MudDialogInstance အစား IMudDialogInstance ကို ပြောင်းလဲသုံးစွဲပါ
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public PrintDocumentModel Document { get; set; } = new();

    private void Close() => MudDialog.Close();

    private async Task PrintVoucher()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync(
                "printVoucher",
                "printable-voucher-area",
                Document.PaperSize,
                Document.CustomWidth,
                Document.CustomHeight
            );
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Print ထုတ်ရာတွင် အမှားအယွင်းရှိပါသည်: {ex.Message}", Severity.Error);
        }
    }
}