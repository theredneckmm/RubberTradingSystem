@using MudBlazor
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject LanguageService LangService
@inject UserContextService UserContext

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isFormValid">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_voucherNo" Label="Adjustment No (ဘောင်ချာနံပါတ်)" Variant="Variant.Outlined" Required="true" Dense="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_adjustmentDate" Label="Date (ရက်စွဲ)" Variant="Variant.Outlined" Required="true" Dense="true" />
                </MudItem>

                <!-- Warehouse -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Warehouse (ဂိုဒေါင်)" Variant="Variant.Outlined" Dense="true" Required="true"
                               Value="_warehouseId" ValueChanged="OnWarehouseChanged">
                        @foreach (var wh in _warehouses)
                        {
                            <MudSelectItem Value="@wh.id">@wh.warehouse_name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Rubber Type -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Rubber Type (ရာဘာအမျိုးအစား)" Variant="Variant.Outlined" Dense="true" Required="true"
                               Value="_rubberTypeId" ValueChanged="OnRubberTypeChanged">
                        @foreach (var type in _rubberTypes)
                        {
                            <MudSelectItem Value="@type.id">@type.name (@type.grade)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Batch Selection (ဂိုဒေါင်နှင့် ရာဘာရွေးပြီးမှ ပေါ်မည်) -->
                <MudItem xs="12">
                    <MudSelect T="string" Label="ရွေးချယ်ရန် ရာဘာအပုံ (Select Batch)" Variant="Variant.Outlined" Dense="true" Required="true"
                               Value="_batchId" ValueChanged="OnBatchChanged" Disabled="@(!_batches.Any())">
                        @if (!_batches.Any())
                        {
                            <MudSelectItem Value="@string.Empty">အထက်ပါဂိုဒေါင်တွင် ဤရာဘာအမျိုးအစား မရှိပါ</MudSelectItem>
                        }
                        else
                        {
                            @foreach (var batch in _batches)
                            {
                                <MudSelectItem Value="@batch.id">@batch.batch_number (လက်ကျန် - @batch.total_weight:N2 @_weightUnit)</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>

                <!-- System Qty (Readonly) -->
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@($"{_systemQty:N2} {_weightUnit}")" Label="စနစ်ပေါ်ရှိ လက်ကျန် (System Stock)" Variant="Variant.Outlined" Dense="true" ReadOnly="true" />
                </MudItem>

                <!-- Actual Physical Qty (User Input) -->
                <MudItem xs="12" sm="4">
                    <MudNumericField Value="_actualQty" ValueChanged="OnActualQtyChanged" T="decimal"
                                     Label="@($"အပြင်လက်ကျန်အမှန် ({_weightUnit})")"
                                     Variant="Variant.Outlined" Dense="true" Min="0" Required="true"
                                     Disabled="@(string.IsNullOrEmpty(_batchId))" />
                </MudItem>

                <!-- Difference (Auto calculated) -->
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@($"{(_actualQty - _systemQty > 0 ? "+" : "")}{(_actualQty - _systemQty):N2} {_weightUnit}")"
                                  Label="ကွာဟချက် (Difference)"
                                  Variant="Variant.Outlined" Dense="true" ReadOnly="true"
                                  Style="@((_actualQty - _systemQty) < 0 ? "color: var(--mud-palette-error); font-weight: bold;" : "color: var(--mud-palette-success); font-weight: bold;")" />
                </MudItem>

                <!-- Reason Selection -->
                <MudItem xs="12">
                    <MudSelect T="string" @bind-Value="_reason" Label="အကြောင်းရင်း (Reason)" Variant="Variant.Outlined" Dense="true" Required="true">
                        <MudSelectItem Value="@("Shrinkage / Weight Loss")">Shrinkage / Weight Loss (အခြောက်ခံချိန် အလေးချိန်လျော့ခြင်း)</MudSelectItem>
                        <MudSelectItem Value="@("Physical Count Error")">Physical Count Error (စာရင်းစစ်အမှား / အပို-အလို)</MudSelectItem>
                        <MudSelectItem Value="@("Damage / Spoiled")">Damage / Spoiled (ပျက်စီးဆုံးရှုံးခြင်း)</MudSelectItem>
                        <MudSelectItem Value="@("Other")">Other (အခြား)</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_note" Label="မှတ်ချက် (Note)" Variant="Variant.Outlined" Dense="true" Lines="2" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">ပိတ်မည်</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@(!_isFormValid || _isSaving || string.IsNullOrEmpty(_batchId) || _systemQty == _actualQty)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {

                <text>သိမ်းမည် (Save)</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = new();
    private bool _isFormValid;
    private bool _isSaving;

    private string _voucherNo = string.Empty;
    private DateTime? _adjustmentDate = DateTime.Today;
    private string _warehouseId = string.Empty;
    private string _rubberTypeId = string.Empty;
    private string _batchId = string.Empty;

    private decimal _systemQty = 0;
    private decimal _actualQty = 0;
    private string _reason = string.Empty;
    private string _note = string.Empty;
    private string _weightUnit = "ပိဿာ";

    private List<WarehouseObj> _warehouses = new();
    private List<RubberTypeObj> _rubberTypes = new();
    private List<BatchObj> _batches = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
        await GenerateVoucherNumberAsync();
        await LoadDropdownsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<List<BusinessSettingModel>>("rest/v1/business_settings?select=default_weight_unit");
            if (settings != null && settings.Any()) _weightUnit = settings.First().default_weight_unit ?? "ပိဿာ";
        }
        catch { }
    }

    private async Task GenerateVoucherNumberAsync()
    {
        string dateStr = DateTime.Now.ToString("yyyyMMdd");
        string prefix = "ADJ";
        try
        {
            var adjs = await Http.GetFromJsonAsync<List<AdjNoObj>>($"rest/v1/stock_adjustments?adjustment_no=like.{prefix}-{dateStr}-*&select=adjustment_no");
            int nextSeq = 1;
            if (adjs != null && adjs.Any())
            {
                var maxSeq = adjs.Where(a => a.adjustment_no != null && a.adjustment_no.Contains("-"))
                                 .Select(a => int.TryParse(a.adjustment_no!.Split('-').Last(), out int val) ? val : 0).DefaultIfEmpty(0).Max();
                nextSeq = maxSeq + 1;
            }
            _voucherNo = $"{prefix}-{dateStr}-{nextSeq:D3}";
        }
        catch { _voucherNo = $"{prefix}-{dateStr}-001"; }
    }

    private async Task LoadDropdownsAsync()
    {
        _warehouses = await Http.GetFromJsonAsync<List<WarehouseObj>>("rest/v1/warehouses?select=id,warehouse_name") ?? new();
        _rubberTypes = await Http.GetFromJsonAsync<List<RubberTypeObj>>("rest/v1/rubber_types?select=id,name,grade") ?? new();
    }

    private async Task OnWarehouseChanged(string id)
    {
        _warehouseId = id;
        await LoadBatchesAsync();
    }

    private async Task OnRubberTypeChanged(string id)
    {
        _rubberTypeId = id;
        await LoadBatchesAsync();
    }

    private async Task LoadBatchesAsync()
    {
        _batchId = string.Empty;
        _systemQty = 0;
        _actualQty = 0;
        _batches.Clear();

        if (string.IsNullOrEmpty(_warehouseId) || string.IsNullOrEmpty(_rubberTypeId)) return;

        try
        {
            // ရွေးချယ်ထားသော ဂိုဒေါင်နှင့် ရာဘာအမျိုးအစားနှင့် ကိုက်ညီသော Active Batches များကို ဆွဲထုတ်မည်
            var batches = await Http.GetFromJsonAsync<List<BatchObj>>($"rest/v1/warehouse_batches?warehouse_id=eq.{_warehouseId}&rubber_type_id=eq.{_rubberTypeId}&status=eq.Active&select=id,batch_number,total_weight");
            if (batches != null) _batches = batches;
        }
        catch { }
        StateHasChanged();
    }

    private void OnBatchChanged(string id)
    {
        _batchId = id;
        var b = _batches.FirstOrDefault(x => x.id == id);
        if (b != null)
        {
            _systemQty = b.total_weight;
            _actualQty = b.total_weight; // Default အနေဖြင့် စနစ်လက်ကျန်ကို အရင်ပြပေးထားမည်
        }
    }

    private void OnActualQtyChanged(decimal val)
    {
        _actualQty = val;
    }

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_isFormValid || _systemQty == _actualQty || string.IsNullOrEmpty(_batchId)) return;

        _isSaving = true;
        try
        {
            string ownerId = await UserContext.GetCurrentOwnerIdAsync();
            string staffId = await UserContext.GetCurrentStaffIdAsync();
            decimal difference = _actualQty - _systemQty;

            // ၁။ Adjustment Record သိမ်းဆည်းခြင်း
            var adjPayload = new
            {
                owner_id = ownerId,
                staff_id = staffId,
                adjustment_no = _voucherNo,
                adjustment_date = _adjustmentDate,
                warehouse_id = _warehouseId,
                rubber_type_id = _rubberTypeId,
                batch_id = _batchId,
                system_qty = _systemQty,
                actual_qty = _actualQty,
                difference = difference,
                reason = _reason,
                note = _note,
                sync_status = "Synced"
            };
            await Http.PostAsJsonAsync("rest/v1/stock_adjustments", adjPayload);

            // ၂။ ကွာဟချက်ကို Items ဇယားတွင် Adjustment အဖြစ် မှတ်တမ်းတင်ခြင်း (History Tracking)
            var itemPayload = new
            {
                owner_id = ownerId,
                staff_id = staffId,
                batch_id = _batchId,
                source_type = "Adjustment",
                source_id = _batchId,
                weight = difference, // အတိုးအလျော့ ကွာဟချက်ကိုသာ မှတ်မည်
                moisture_percent = 0m
            };
            await Http.PostAsJsonAsync("rest/v1/warehouse_batch_items", itemPayload);

            // ၃။ Batch ဇယား၏ Total Weight ကို အပြင်လက်ကျန် (Actual) အတိုင်း အတိအကျ Update လုပ်ခြင်း
            await Http.PatchAsync($"rest/v1/warehouse_batches?id=eq.{_batchId}", JsonContent.Create(new { total_weight = _actualQty }));

            Snackbar.Add("လက်ကျန်ညှိနှိုင်းမှု အောင်မြင်စွာ ပြီးစီးပါပြီ။", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class BusinessSettingModel { public string? default_weight_unit { get; set; } }
    private class AdjNoObj { public string? adjustment_no { get; set; } }
    private class WarehouseObj { public string id { get; set; } = ""; public string warehouse_name { get; set; } = ""; }
    private class RubberTypeObj { public string id { get; set; } = ""; public string name { get; set; } = ""; public string grade { get; set; } = ""; }
    private class BatchObj { public string id { get; set; } = ""; public string batch_number { get; set; } = ""; public decimal total_weight { get; set; } }
}