@page "/employee/add"
@using MudBlazor
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject LanguageService LangService
@inject UserContextService UserContext
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 mb-6">
    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4"><b>@LangService.GetString("Title_AddStaff")</b></MudText>

    <MudPaper Class="pa-6" Elevation="3">
        <EditForm Model="@_model" OnValidSubmit="SaveStaffAsync">
            <DataAnnotationsValidator />

            <MudGrid Spacing="3">
                <!-- ဝန်ထမ်းအမည် -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.name" Label="@LangService.GetString("Lbl_Name")"
                                  Variant="Variant.Outlined" Dense="true" Required="true" />
                </MudItem>

                <!-- ရာထူး / တာဝန် -->
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.position" Label="@LangService.GetString("Lbl_Position")"
                                  Variant="Variant.Outlined" Dense="true" Required="true" />
                </MudItem>

                <!-- ဖုန်းနံပါတ် -->
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.phone" Label="@LangService.GetString("Lbl_Phone")"
                                  Variant="Variant.Outlined" Dense="true" />
                </MudItem>

                <!-- အခြေခံလစာ -->
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal" @bind-Value="_model.basic_salary" Label="@LangService.GetString("Lbl_BasicSalary")"
                                     Variant="Variant.Outlined" Dense="true" Min="0" Format="N0" />
                </MudItem>

                <!-- အလုပ်အခြေအနေ -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_model.status" Label="@LangService.GetString("Th_Status")"
                               Variant="Variant.Outlined" Dense="true">
                        <MudSelectItem Value="@("Active")">တက်ကြွ (Active)</MudSelectItem>
                        <MudSelectItem Value="@("Resigned")">ထွက်ခွာ (Resigned)</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <!-- Action Buttons -->
            <div class="d-flex justify-end gap-3 mt-6">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/staff">
                    @LangService.GetString("Btn_Cancel")
                </MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_isSaving">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <text>@LangService.GetString("Btn_Save")</text>
                    }
                </MudButton>
            </div>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private bool _isSaving = false;
    private StaffCreateModel _model = new();

    protected override void OnInitialized() => LangService.OnLanguageChanged += StateHasChanged;
    public void Dispose() => LangService.OnLanguageChanged -= StateHasChanged;

    private async Task SaveStaffAsync()
    {
        _isSaving = true;
        try
        {
            var ownerId = await UserContext.GetCurrentOwnerIdAsync();
            var staffId = await UserContext.GetCurrentStaffIdAsync();

            var payload = new
            {
                owner_id = ownerId,
                staff_id = string.IsNullOrEmpty(staffId) ? null : staffId,
                name = _model.name,
                position = _model.position,
                phone = _model.phone,
                basic_salary = _model.basic_salary,
                status = _model.status,
                sync_status = "Synced"
            };

            var resp = await Http.PostAsJsonAsync("rest/v1/staff", payload);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("ဝန်ထမ်းအသစ် အောင်မြင်စွာ ထည့်သွင်းပြီးပါပြီ။", Severity.Success);
                Navigation.NavigateTo("/staff");
            }
            else
            {
                Snackbar.Add("ဝန်ထမ်းထည့်သွင်းရန် မအောင်မြင်ပါ။", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    public class StaffCreateModel
    {
        public string name { get; set; } = string.Empty;
        public string position { get; set; } = string.Empty;
        public string? phone { get; set; }
        public decimal basic_salary { get; set; }
        public string status { get; set; } = "Active";
    }
}