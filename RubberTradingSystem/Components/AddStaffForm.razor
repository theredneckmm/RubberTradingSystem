@page "/employee/add"
@using MudBlazor
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject LanguageService LangService
@inject UserContextService UserContext
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 mb-6">
    <MudText Typo="Typo.h5" Style="color: #4caf50; font-weight: 700;" Class="mb-4">
        <b>@(_isEditMode ? LangService.GetString("Title_EditStaff") : LangService.GetString("Title_AddStaff"))</b>
    </MudText>

    <MudPaper Class="pa-6" Elevation="3" Style="background-color: #1e293b;">
        <EditForm Model="@_model" OnValidSubmit="SaveStaffAsync">
            <DataAnnotationsValidator />

            <MudGrid Spacing="3">
                <!-- ဝန်ထမ်းအမည် -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.name" Label="@LangService.GetString("Lbl_Name")"
                                  Variant="Variant.Outlined" Dense="true" Required="true" />
                </MudItem>

                <!-- ရာထူး / တာဝန် -->
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.position" Label="@LangService.GetString("Lbl_Position")"
                                  Variant="Variant.Outlined" Dense="true" Required="true" />
                </MudItem>

                <!-- ဖုန်းနံပါတ် -->
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.phone" Label="@LangService.GetString("Lbl_Phone")"
                                  Variant="Variant.Outlined" Dense="true" />
                </MudItem>

                <!-- အခြေခံလစာ -->
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal" @bind-Value="_model.basic_salary" Label="@LangService.GetString("Lbl_BasicSalary")"
                                     Variant="Variant.Outlined" Dense="true" Min="0" Format="N0" />
                </MudItem>

                <!-- အလုပ်အခြေအနေ -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_model.status" Label="@LangService.GetString("Th_Status")"
                               Variant="Variant.Outlined" Dense="true">
                        <MudSelectItem Value="@("Active")">တက်ကြွ (Active)</MudSelectItem>
                        <MudSelectItem Value="@("Resigned")">ထွက်ခွာ (Resigned)</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <!-- Action Buttons -->
            <div class="d-flex justify-end gap-3 mt-6">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/staff">
                    @LangService.GetString("Btn_Cancel")
                </MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Style="background-color: #22c55e; color: white;" Disabled="_isSaving">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <text>@(_isEditMode ? LangService.GetString("Btn_Update") : LangService.GetString("Btn_Save"))</text>
                    }
                </MudButton>
            </div>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private bool _isSaving = false;
    private bool _isEditMode = false;
    private string? _staffId;
    private StaffFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await CheckRouteQueryAsync();
    }

    public void Dispose() => LangService.OnLanguageChanged -= StateHasChanged;

    private async Task CheckRouteQueryAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var idValue = query["id"];

        if (!string.IsNullOrEmpty(idValue))
        {
            _staffId = idValue;
            _isEditMode = true;
            await LoadStaffForEditAsync(_staffId);
        }
        else
        {
            _isEditMode = false;
            _model = new StaffFormModel();
        }
    }

    private async Task LoadStaffForEditAsync(string id)
    {
        try
        {
            var list = await Http.GetFromJsonAsync<List<StaffFormModel>>($"rest/v1/staff?id=eq.{id}&select=*");
            if (list != null && list.Any())
            {
                _model = list.First();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading staff: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveStaffAsync()
    {
        _isSaving = true;
        try
        {
            var ownerId = await UserContext.GetCurrentOwnerIdAsync();
            var staffIdContext = await UserContext.GetCurrentStaffIdAsync();

            if (_isEditMode && !string.IsNullOrEmpty(_staffId))
            {
                // Update Existing Staff
                var payload = new
                {
                    name = _model.name,
                    position = _model.position,
                    phone = _model.phone,
                    basic_salary = _model.basic_salary,
                    status = _model.status,
                    sync_status = "Synced"
                };

                var resp = await Http.PatchAsync($"rest/v1/staff?id=eq.{_staffId}", JsonContent.Create(payload));
                if (resp.IsSuccessStatusCode)
                {
                    Snackbar.Add("ဝန်ထမ်းအချက်အလက် ပြင်ဆင်ပြီးပါပြီ။", Severity.Success);
                    Navigation.NavigateTo("/staff");
                }
            }
            else
            {
                // Create New Staff
                var payload = new
                {
                    owner_id = ownerId,
                    staff_id = string.IsNullOrEmpty(staffIdContext) ? null : staffIdContext,
                    name = _model.name,
                    position = _model.position,
                    phone = _model.phone,
                    basic_salary = _model.basic_salary,
                    status = _model.status,
                    sync_status = "Synced"
                };

                var resp = await Http.PostAsJsonAsync("rest/v1/staff", payload);
                if (resp.IsSuccessStatusCode)
                {
                    Snackbar.Add("ဝန်ထမ်းအသစ် ထည့်သွင်းပြီးပါပြီ။", Severity.Success);
                    Navigation.NavigateTo("/staff");
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    public class StaffFormModel
    {
        public string name { get; set; } = string.Empty;
        public string position { get; set; } = string.Empty;
        public string? phone { get; set; }
        public decimal basic_salary { get; set; }
        public string status { get; set; } = "Active";
    }
}