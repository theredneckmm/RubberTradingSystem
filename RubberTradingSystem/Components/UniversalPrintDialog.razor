@using MudBlazor
@using RubberTradingSystem.Models
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<MudDialog MaxWidth="MaxWidth.Large" Class="pa-0">
    <TitleContent>
        <div class="d-flex justify-space-between align-center">
            <MudText Typo="Typo.h6"><b>@_meta.VoucherTypeTitle Print Preview (@_paperSize)</b></MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" />
        </div>
    </TitleContent>
    <DialogContent>
        <style>
                    @GetPaperSizeCss()

                    @@media print {
                        body * {
                            visibility: hidden !important;
                        }

                        #print-area, #print-area * {
                            visibility: visible !important;
                        }

                        #print-area {
                            position: absolute !important;
                            left: 0 !important;
                            top: 0 !important;
                            width: 100% !important;
                            margin: 0 !important;
                            padding: 10mm !important;
                            background: white !important;
                            color: black !important;
                            box-shadow: none !important;
                            border: none !important;
                        }
                    }
        </style>

        <div class="d-flex justify-center" style="background-color: #333; padding: 20px; overflow: auto;">
            <div id="print-area" class="bg-white text-black rounded" style="width: @GetPreviewWidth(); min-height: 450px; padding: 25px; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid #ccc;">

                <div>
                    <!-- HEADER -->
                    <div style="text-align: center; margin-bottom: 15px;">
                        <div style="font-size: 20px; font-weight: bold; color: #000;">@_headerTitle</div>
                        <div style="font-size: 12px; color: #333; white-space: pre-line; margin-top: 4px;">@_headerAddress</div>
                        <div style="border-bottom: 2px solid #000; margin-top: 8px; margin-bottom: 12px;"></div>
                    </div>

                    <!-- VOUCHER META -->
                    <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 8px;">
                        <div><b>ဘောက်ချာအမှတ်:</b> @_meta.VoucherNumber</div>
                        <div><b>ရက်စွဲ:</b> @_meta.VoucherDate?.ToString("dd/MM/yyyy")</div>
                    </div>

                    <!-- DETAILS -->
                    <div style="font-size: 13px; line-height: 1.6; margin-bottom: 15px;">
                        <div><b>@_meta.PartyRoleLabel</b> @_meta.PartyName</div>
                        @if (_meta.DueDate != null)
                        {
                            <div><b>သတ်မှတ်ရက် (Due Date):</b> @_meta.DueDate?.ToString("dd/MM/yyyy")</div>
                        }
                    </div>

                    <!-- DYNAMIC TABLE -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 13px;">
                        <thead>
                            <tr style="border-bottom: 2px solid #000; border-top: 1px solid #000;">
                                <th style="text-align: left; padding: 8px;">အကြောင်းအရာ</th>
                                <th style="text-align: right; padding: 8px;">ပိဿာချိန်/ပမာဏ</th>
                                <th style="text-align: right; padding: 8px;">နှုန်း</th>
                                <th style="text-align: right; padding: 8px;">စုစုပေါင်းငွေ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _meta.Items)
                            {
                                <tr style="border-bottom: 1px solid #ddd;">
                                    <td style="padding: 8px;">
                                        <b>@item.Title</b><br />
                                        @if (!string.IsNullOrEmpty(item.Subtitle))
                                        {
                                            <span style="font-size: 11px; color: #555;">(@item.Subtitle)</span>
                                        }
                                    </td>
                                    <td style="text-align: right; padding: 8px;">@item.Quantity.ToString("N0")</td>
                                    <td style="text-align: right; padding: 8px;">@item.UnitPrice.ToString("N0")</td>
                                    <td style="text-align: right; padding: 8px; font-weight: bold;">@item.TotalAmount.ToString("N0") MMK</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- DESCRIPTION -->
                    @if (!string.IsNullOrEmpty(_meta.Description))
                    {
                        <div style="font-size: 13px; margin-bottom: 20px;">
                            <b>မှတ်ချက်:</b> @_meta.Description
                        </div>
                    }
                </div>

                <!-- FOOTER -->
                <div style="text-align: center; border-top: 1px dashed #777; padding-top: 12px; font-size: 12px; color: #555;">
                    @_footerNote
                </div>

            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Close">ပိတ်မည်</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" OnClick="TriggerPrint">တိုက်ရိုက်ထုတ်မည် (Print)</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public PrintContextModel Data { get; set; } = new();

    private PrintContextModel _meta => Data ?? new();
    private string _paperSize = "A5";
    private int _customWidth = 148;
    private int _customHeight = 210;
    private string _headerTitle = "ရွှေပြည်စိုး ရာဘာကုန်သွယ်လုပ်ငန်း";
    private string _headerAddress = "";
    private string _footerNote = "ကျေးဇူးတင်ပါသည်";

    protected override async Task OnInitializedAsync()
    {
        await LoadPrinterSettingsAsync();
    }

    private async Task LoadPrinterSettingsAsync()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<List<PrinterSettingRaw>>("rest/v1/printer_settings?select=*&limit=1");
            if (settings != null && settings.Any())
            {
                var s = settings.First();
                _paperSize = string.IsNullOrEmpty(s.voucher_size) ? "A5" : s.voucher_size;
                _customWidth = s.custom_width > 0 ? s.custom_width : 148;
                _customHeight = s.custom_height > 0 ? s.custom_height : 210;
                _headerTitle = string.IsNullOrEmpty(s.header_title) ? _headerTitle : s.header_title;
                _headerAddress = s.header_address ?? "";
                _footerNote = string.IsNullOrEmpty(s.footer_note) ? _footerNote : s.footer_note;
            }
        }
        catch { }
    }

    private void Close() => MudDialog.Close();

    private string GetPaperSizeCss()
    {
        return _paperSize switch
        {
            "A4" => "@page { size: A4 portrait; margin: 10mm; }",
            "A5" => "@page { size: A5 portrait; margin: 8mm; }",
            "A6" => "@page { size: A6 portrait; margin: 5mm; }",
            "Custom" => $"@page {{ size: {_customWidth}mm {_customHeight}mm; margin: 5mm; }}",
            _ => "@page { size: A5 portrait; margin: 8mm; }"
        };
    }

    private string GetPreviewWidth()
    {
        return _paperSize switch
        {
            "A4" => "550px",
            "A5" => "450px",
            "A6" => "350px",
            "Custom" => "450px",
            _ => "450px"
        };
    }

    private async Task TriggerPrint()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private class PrinterSettingRaw
    {
        public string? voucher_size { get; set; }
        public int custom_width { get; set; }
        public int custom_height { get; set; }
        public string? header_title { get; set; }
        public string? header_address { get; set; }
        public string? footer_note { get; set; }
    }
}