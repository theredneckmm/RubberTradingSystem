@page "/expense-settings"
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject LanguageService Lang
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject HttpClient Http
@inject UserContextService UserContext
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-6">
    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4 font-weight-bold">
        @Lang.GetString("ExpSetting_Title")
    </MudText>

    <MudTable Items="@_items"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="new Func<ExpenseSettingModel,bool>(FilterFunc)"
              @bind-SelectedItem="_selectedItem"
              RowClassFunc="SelectedRowClassFunc"
              Elevation="2">

        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString"
                          Placeholder="@Lang.GetString("ExpSetting_SearchPlaceholder")"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-0"
                          Clearable="true">
            </MudTextField>
        </ToolBarContent>

        <HeaderContent>
            <MudTh><b>@Lang.GetString("ExpSetting_ColType")</b></MudTh>
            <MudTh><b>@Lang.GetString("ExpSetting_ColName")</b></MudTh>
            <MudTh><b>@Lang.GetString("ExpSetting_ColParentCategory")</b></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Type">
                <MudChip T="string" Color="@(context.SettingType == "Category" ? Color.Primary : Color.Info)" Size="Size.Small">
                    @context.SettingType
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Name"><b style="color: var(--mud-palette-text-primary);">@context.SettingName</b></MudTd>
            <MudTd DataLabel="Parent Category">
                @if (context.SettingType == "Title")
                {
                    <span>@GetCategoryName(context.CategoryId)</span>
                }
                else
                {
                    <span style="color: gray;">- (Main Category) -</span>
                }
            </MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>

    <!-- အောက်ခြေ ခလုတ်များ -->
    <MudPaper Class="d-flex justify-end pa-4 mt-4" Elevation="2">
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog" Class="mr-2">
            @Lang.GetString("ExpSetting_AddBtn")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit"
                   Disabled="@(_selectedItem == null)" OnClick="OpenEditDialog" Class="mr-2">
            @Lang.GetString("Btn_SaveChanges")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                   Disabled="@(_selectedItem == null)" OnClick="DeleteAsync">
            @Lang.GetString("ExpSetting_DeleteBtn")
        </MudButton>
    </MudPaper>
</MudContainer>

<style>
    .selected-row {
        background-color: rgba(33, 150, 243, 0.2) !important;
    }
</style>

@code {
    private List<ExpenseSettingModel> _items = new();
    private ExpenseSettingModel? _selectedItem;
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        Lang.OnLanguageChanged += StateHasChanged;
        await LoadDataAsync();
    }

    public void Dispose() => Lang.OnLanguageChanged -= StateHasChanged;

    private async Task LoadDataAsync()
    {
        try
        {
            _items = await Http.GetFromJsonAsync<List<ExpenseSettingModel>>("rest/v1/expense_settings?select=*&order=created_at.desc") ?? new();
            _selectedItem = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private string GetCategoryName(string? categoryId)
    {
        if (string.IsNullOrEmpty(categoryId)) return "-";
        var cat = _items.FirstOrDefault(x => x.Id == categoryId);
        return cat?.SettingName ?? "-";
    }

    private string SelectedRowClassFunc(ExpenseSettingModel item, int rowNumber)
    {
        if (_selectedItem != null && _selectedItem.Id == item.Id)
        {
            return "selected-row";
        }
        return string.Empty;
    }

    private bool FilterFunc(ExpenseSettingModel item)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        return (!string.IsNullOrEmpty(item.SettingName) && item.SettingName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) ||
               (!string.IsNullOrEmpty(item.SettingType) && item.SettingType.Contains(_searchString, StringComparison.OrdinalIgnoreCase));
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters { ["Model"] = new ExpenseSettingModel(), ["IsNew"] = true, ["AllItems"] = _items };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ExpenseSettingDialog>(Lang.GetString("ExpSetting_AddTitle"), parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled) await LoadDataAsync();
    }

    private async Task OpenEditDialog()
    {
        if (_selectedItem == null) return;
        var editModel = new ExpenseSettingModel
        {
            Id = _selectedItem.Id,
            OwnerId = _selectedItem.OwnerId,
            StaffId = _selectedItem.StaffId,
            SettingType = _selectedItem.SettingType,
            SettingName = _selectedItem.SettingName,
            CategoryId = _selectedItem.CategoryId
        };

        var parameters = new DialogParameters { ["Model"] = editModel, ["IsNew"] = false, ["AllItems"] = _items };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ExpenseSettingDialog>(Lang.GetString("ExpSetting_EditTitle"), parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled) await LoadDataAsync();
    }

    private async Task DeleteAsync()
    {
        if (_selectedItem == null) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            Lang.GetString("Confirm_Title"),
            Lang.GetString("Confirm_DeleteMessage"),
            yesText: Lang.GetString("Btn_Yes"), cancelText: Lang.GetString("Btn_Cancel"));

        if (confirmed == true)
        {
            try
            {
                var response = await Http.DeleteAsync($"rest/v1/expense_settings?id=eq.{_selectedItem.Id}");
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add(Lang.GetString("ExpSetting_DeleteSuccess"), Severity.Success);
                    await LoadDataAsync();
                }
                else
                {
                    Snackbar.Add("Failed to delete setting.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }
}