@page "/login"
@attribute [AllowAnonymous]
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using RubberTradingSystem.Auth
@using RubberTradingSystem.Models
@using MudBlazor
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 9999; background-color: rgba(0, 0, 0, 0.4); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); overflow: hidden;" class="d-flex justify-center align-center">

    <MudCard Elevation="8" Class="pa-8" Style="max-width: 450px; width: 100%; border-radius: 16px; background-color: var(--mud-palette-surface);">
        <MudCardHeader Class="d-flex justify-center pb-0">
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Primary" Style="font-weight: 700;">
                    Rubber Trading ERP
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-1 mud-text-secondary">
                    Welcome back! Please login to your account.
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_loginModel.Email"
                              Label="Email"
                              Variant="Variant.Outlined"
                              Margin="Margin.Normal"
                              InputType="InputType.Email"
                              For="@(() => _loginModel.Email)"
                              Required="true" />

                <MudTextField @bind-Value="_loginModel.Password"
                              Label="Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Normal"
                              InputType="InputType.Password"
                              For="@(() => _loginModel.Password)"
                              Required="true" />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-4 rounded">
                        @_errorMessage
                    </MudAlert>
                }

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           FullWidth="true"
                           Class="mt-6 py-2"
                           Disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Authenticating...</MudText>
                    }
                    else
                    {
                        <MudText>Login</MudText>
                    }
                </MudButton>
            </EditForm>
        </MudCardContent>
    </MudCard>

</div>


@code {
    private LoginDto _loginModel = new();
    private bool _isLoading;
    private string? _errorMessage;

    private const string SupabaseUrl = "https://wfmtlazbkvyrfrjxgftp.supabase.co";
    private const string SupabaseAnonKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndmbXRsYXpia3Z5cmZyanhnZnRwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY3ODI0MTQsImV4cCI6MjEwMjM1ODQxNH0.breIcpiroqWRIX8Cvii14mPJJs1Q3v1yugoPnYZYSOM";

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var requestBody = new
            {
                email = _loginModel.Email,
                password = _loginModel.Password
            };

            using var request = new HttpRequestMessage(HttpMethod.Post, "auth/v1/token?grant_type=password");
            request.Headers.Add("apikey", SupabaseAnonKey);
            request.Content = JsonContent.Create(requestBody);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var authResult = await response.Content.ReadFromJsonAsync<SupabaseTokenResponse>();
                if (authResult != null)
                {
                    var supabaseAuth = (SupabaseAuthStateProvider)AuthStateProvider;
                    // Access Token ရော Refresh Token ပါ တစ်ခါတည်း သိမ်းပေးပါမယ်
                    await supabaseAuth.MarkUserAsAuthenticated(authResult.AccessToken, authResult.RefreshToken);

                    Snackbar.Add("Login အောင်မြင်ပါသည်", Severity.Success);
                    //Navigation.NavigateTo("/");
                    // Login အောင်မြင်သွားသောအခါ
                    Navigation.NavigateTo("/", forceLoad: true);
                }
            }
            else
            {
                _errorMessage = "အီးမေးလ် (သို့မဟုတ်) စကားဝှက် မှားယွင်းနေပါသည်။";
                Snackbar.Add(_errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"ချိတ်ဆက်မှု အမှားအယွင်း: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }


    public class LoginDto
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class SupabaseAuthResponse
    {
        [JsonPropertyName("access_token")]
        public string AccessToken { get; set; } = string.Empty;

        [JsonPropertyName("refresh_token")]
        public string RefreshToken { get; set; } = string.Empty;
    }
}