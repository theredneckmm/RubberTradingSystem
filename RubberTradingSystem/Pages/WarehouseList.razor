@page "/warehouses"
@using MudBlazor
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject LanguageService LangService
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4 font-weight-bold">@LangService.GetString("Wh_ListTitle")</MudText>

    <MudTable Items="@_items"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="new Func<WarehouseModel,bool>(FilterFunc)"
              @bind-SelectedItem="_selectedItem"
              RowClass="cursor-pointer"
              Elevation="2">

        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString"
                          Placeholder="@LangService.GetString("Wh_SearchPlaceholder")"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-0"
                          Clearable="true">
            </MudTextField>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>@LangService.GetString("Wh_ColName")</MudTh>
            <MudTh>@LangService.GetString("Wh_ColLocation")</MudTh>
            <MudTh>@LangService.GetString("Wh_ColManager")</MudTh>
            <MudTh>@LangService.GetString("Wh_ColPhone")</MudTh>
            <MudTh>@LangService.GetString("Wh_ColCapacity")</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Warehouse Name"><b>@context.warehouse_name</b></MudTd>
            <MudTd DataLabel="Location">@context.location</MudTd>
            <MudTd DataLabel="Manager">@context.manager_name</MudTd>
            <MudTd DataLabel="Phone">@context.phone</MudTd>
            <MudTd DataLabel="Capacity">@context.capacity_desc</MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>

    <MudPaper Class="d-flex justify-end pa-4 mt-4" Elevation="2">
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog" Class="mr-2">
            @LangService.GetString("Wh_AddButton")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit"
                   Disabled="@(_selectedItem == null)" OnClick="OpenEditDialog" Class="mr-2">
            @LangService.GetString("Wh_EditButton")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                   Disabled="@(_selectedItem == null)" OnClick="DeleteAsync">
            @LangService.GetString("Wh_DeleteButton")
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private List<WarehouseModel> _items = new();
    private WarehouseModel? _selectedItem;
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += StateHasChanged;
        await LoadDataAsync();
    }

    public void Dispose() => LangService.OnLanguageChanged -= StateHasChanged;

    private async Task LoadDataAsync()
    {
        try
        {
            _items = await Http.GetFromJsonAsync<List<WarehouseModel>>("rest/v1/warehouses?select=*&order=warehouse_name.asc") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private bool FilterFunc(WarehouseModel item)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        return (!string.IsNullOrEmpty(item.warehouse_name) && item.warehouse_name.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) ||
               (!string.IsNullOrEmpty(item.location) && item.location.Contains(_searchString, StringComparison.OrdinalIgnoreCase));
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters { ["Model"] = new WarehouseModel(), ["IsNew"] = true };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<WarehouseDialog>(LangService.GetString("Wh_AddTitle"), parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled) await LoadDataAsync();
    }

    private async Task OpenEditDialog()
    {
        if (_selectedItem == null) return;
        var editModel = new WarehouseModel
        {
            id = _selectedItem.id,
            owner_id = _selectedItem.owner_id,
            warehouse_name = _selectedItem.warehouse_name,
            location = _selectedItem.location,
            manager_name = _selectedItem.manager_name,
            phone = _selectedItem.phone,
            capacity_desc = _selectedItem.capacity_desc
        };

        var parameters = new DialogParameters { ["Model"] = editModel, ["IsNew"] = false };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<WarehouseDialog>(LangService.GetString("Wh_EditTitle"), parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled) await LoadDataAsync();
    }

    private async Task DeleteAsync()
    {
        if (_selectedItem == null) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm",
            LangService.GetString("Wh_DeleteConfirm"),
            yesText: "Yes", cancelText: "Cancel");

        if (confirmed == true)
        {
            var response = await Http.DeleteAsync($"rest/v1/warehouses?id=eq.{_selectedItem.id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(LangService.GetString("Wh_DeleteSuccess"), Severity.Success);
                await LoadDataAsync();
                _selectedItem = null;
            }
            else
            {
                Snackbar.Add("Failed to delete warehouse.", Severity.Error);
            }
        }
    }
}