@page "/reports/buyer-contract-status"
@using MudBlazor
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject LanguageService LangService
@inject IJSRuntime JS
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-6">
    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">@LangService.GetString("Title_BuyerContractStatusReport")</MudText>

    <MudTable Items="@_items" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@_isLoading" Elevation="2">
        <HeaderContent>
            <MudTh>@LangService.GetString("Th_BuyerName")</MudTh>
            <MudTh>@LangService.GetString("Th_ContractQty")</MudTh>
            <MudTh>@LangService.GetString("Th_DeliveredQty")</MudTh>
            <MudTh>@LangService.GetString("Th_RemainingQty")</MudTh>
            <MudTh>@LangService.GetString("Th_Status")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><b>@context.MerchantName</b></MudTd>
            <MudTd>@context.ContractQuantity.ToString("N2")</MudTd>
            <MudTd>@context.DeliveredQuantity.ToString("N2")</MudTd>
            <MudTd><b>@context.RemainingQuantity.ToString("N2")</b></MudTd>
            <MudTd><MudChip T="string" Color="@(context.Status == "Active" ? Color.Warning : Color.Success)" Size="Size.Small">@context.Status</MudChip></MudTd>
        </RowTemplate>
        <PagerContent><MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" /></PagerContent>
    </MudTable>
</MudContainer>

@code {
    private bool _isLoading = false;
    private List<ContractStatusModel> _items = new();

    protected override async Task OnInitializedAsync() { LangService.OnLanguageChanged += StateHasChanged; await LoadDataAsync(); }
    public void Dispose() => LangService.OnLanguageChanged -= StateHasChanged;

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            var raw = await Http.GetFromJsonAsync<List<RawContractModel>>("rest/v1/forward_contracts?select=contract_quantity,delivered_quantity,status,contacts(name)") ?? new();
            _items = raw.Select(x => new ContractStatusModel
            {
                MerchantName = x.contacts?.name ?? "N/A",
                ContractQuantity = x.contract_quantity,
                DeliveredQuantity = x.delivered_quantity,
                Status = x.status
            }).ToList();
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private async Task ExportToExcelAsync()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Buyer,Contract Qty,Delivered Qty,Remaining Qty,Status");
        foreach (var i in _items) csv.AppendLine($"\"{i.MerchantName}\",{i.ContractQuantity},{i.DeliveredQuantity},{i.RemainingQuantity},\"{i.Status}\"");
        await JS.InvokeVoidAsync("downloadFileFromBytes", $"Buyer_Contract_Status_{DateTime.Now:yyyyMMdd}.csv", "text/csv", System.Text.Encoding.UTF8.GetBytes(csv.ToString()));
    }

    public class ContractStatusModel { public string MerchantName { get; set; } = string.Empty; public decimal ContractQuantity { get; set; } public decimal DeliveredQuantity { get; set; } public decimal RemainingQuantity => ContractQuantity - DeliveredQuantity; public string Status { get; set; } = "Active"; }
    private class RawContractModel { public decimal contract_quantity { get; set; } public decimal delivered_quantity { get; set; } public string status { get; set; } = "Active"; public ContactObj? contacts { get; set; } }
    private class ContactObj { public string name { get; set; } = string.Empty; }
}