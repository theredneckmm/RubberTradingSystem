@page "/advance/in"
@page "/advance/in/edit/{EditTransactionId}"
@using MudBlazor
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject LanguageService Lang
@inject UserContextService UserContext
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">
    <MudPaper Elevation="3" Class="pa-6">
        <!-- ခေါင်းစဉ်နှင့် ဘောင်ချာနံပါတ် -->
        <div class="d-flex justify-space-between align-center mb-6">
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold">
                @(_isEditMode ? Lang.GetString("Btn_Edit") : Lang.GetString("Title_AdvanceIn"))
            </MudText>
            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Large"><b>@_voucherNumber</b></MudChip>
        </div>

        <MudForm @ref="_form" @bind-IsValid="@_success">
            <MudGrid>
                <!-- ခြံရှင် ရွေးချယ်ခြင်း -->
                <MudItem xs="12">
                    <MudSelect T="string" Label="@Lang.GetString("Lbl_SelectSupplier")" @bind-Value="_selectedContactId"
                               SelectedValuesChanged="OnSupplierSelected"
                               Required="true" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                               Disabled="_isSuccessCompleted">
                        @foreach (var contact in _suppliers)
                        {
                            <MudSelectItem Value="@contact.Id">@contact.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- ရွေးချယ်ထားသော ခြံရှင်၏ လက်ရှိ Advance Balance ကို ပြသရန် -->
                @if (_selectedContact != null)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            @Lang.GetString("Lbl_CurrentAdvance"): <b>@_currentAdvanceBalance.ToString("N2") MMK</b>
                        </MudAlert>
                    </MudItem>
                }

                <!-- ငွေလက်ခံမည့် Wallet ကို ရွေးချယ်ခြင်း -->
                <MudItem xs="12">
                    <MudSelect T="string" Label="@Lang.GetString("Lbl_SelectWallet")" @bind-Value="_selectedWalletId"
                               Required="true" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                               Disabled="_isSuccessCompleted">
                        @foreach (var wallet in _wallets)
                        {
                            <MudSelectItem Value="@wallet.Id">@wallet.WalletName (@wallet.WalletType) - လက်ကျန်: @wallet.Balance.ToString("N2")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- ပြန်ဆပ်သည့် ငွေပမာဏ -->
                <MudItem xs="12">
                    <MudNumericField @bind-Value="_amount" Label="@Lang.GetString("Lbl_Amount")"
                                     Required="true" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentText="MMK" HideSpinButtons="true" Min="0"
                                     Disabled="_isSuccessCompleted" />
                </MudItem>

                <!-- မှတ်ချက် -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="_description" Label="@Lang.GetString("Lbl_Note")" Variant="Variant.Outlined" Lines="2"
                                  Disabled="_isSuccessCompleted" />
                </MudItem>
            </MudGrid>

            <!-- ခလုတ်များ အပိုင်း -->
            <div class="d-flex justify-end gap-3 mt-6">
                @if (!_isSuccessCompleted)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveAdvanceInAsync"
                               Disabled="@(!_success || _isSaving)">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            <text>@(_isEditMode ? Lang.GetString("Btn_Edit") : Lang.GetString("Btn_ReceiveAdvance"))</text>
                        }
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Disabled="true">
                        @(_isEditMode ? Lang.GetString("Btn_Edit") : Lang.GetString("Btn_ReceiveAdvance"))
                    </MudButton>
                }

                <!-- Print ခလုတ် -->
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="PrintVoucher"
                           Disabled="!_isSuccessCompleted">
                    Print Voucher
                </MudButton>

                <!-- Finish ခလုတ် -->
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="FinishTransaction"
                           Disabled="!_isSuccessCompleted">
                    Finish
                </MudButton>
            </div>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    [Parameter]
    public string? EditTransactionId { get; set; }

    private bool _isEditMode => !string.IsNullOrEmpty(EditTransactionId);

    private MudForm _form = new();
    private bool _success;
    private bool _isSaving;
    private bool _isSuccessCompleted = false;
    private string _voucherNumber = string.Empty;

    private List<Contact> _suppliers = new();
    private List<WalletModel> _wallets = new();
    private string _selectedContactId = string.Empty;
    private Contact? _selectedContact;
    private decimal _currentAdvanceBalance = 0m;
    private string _selectedWalletId = string.Empty;
    private decimal _amount;
    private string _description = string.Empty;

    // ပြင်ဆင်ရန် (Edit) အတွက် မူလဒေတာများ သိမ်းထားရန်
    private decimal _originalAmount = 0;
    private string _originalContactId = string.Empty;
    private string _originalWalletId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Lang.OnLanguageChanged += StateHasChanged;
        await LoadInitialDataAsync();

        if (_isEditMode)
        {
            await LoadExistingTransactionAsync();
        }
    }

    private async Task LoadInitialDataAsync()
    {
        var allContacts = await Http.GetFromJsonAsync<List<Contact>>("rest/v1/contacts?select=*");
        _suppliers = allContacts?.Where(c => c.ContactType == "Supplier").ToList() ?? new();

        var ownerId = await UserContext.GetCurrentOwnerIdAsync();
        _wallets = await Http.GetFromJsonAsync<List<WalletModel>>($"rest/v1/wallets?owner_id=eq.{ownerId}&select=*") ?? new();

        if (!_isEditMode)
        {
            var cashWallet = _wallets.FirstOrDefault(w => w.WalletType.Equals("Cash", StringComparison.OrdinalIgnoreCase));
            if (cashWallet != null)
            {
                _selectedWalletId = cashWallet.Id;
            }
            else if (_wallets.Any())
            {
                _selectedWalletId = _wallets.First().Id;
            }

            _voucherNumber = await GenerateVoucherNumberAsync("ADV-IN");
        }
    }

    private async Task LoadExistingTransactionAsync()
    {
        try
        {
            var txList = await Http.GetFromJsonAsync<List<TransactionModel>>($"rest/v1/transactions?id=eq.{EditTransactionId}&select=*");
            if (txList != null && txList.Any())
            {
                var tx = txList.First();
                _voucherNumber = tx.voucher_number ?? "";
                _selectedContactId = tx.contact_id ?? "";
                _selectedWalletId = tx.wallet_id ?? "";
                _amount = tx.total_amount;
                _description = tx.description ?? "";

                // မူလတန်ဖိုးများကို သိမ်းထားမည်
                _originalAmount = tx.total_amount;
                _originalContactId = tx.contact_id ?? "";
                _originalWalletId = tx.wallet_id ?? "";

                // ရွေးချယ်ထားသော Contact ၏ လက်ရှိ Advance ကို တွက်ချက်ပြသရန်
                var selectedParams = new List<string> { _selectedContactId };
                OnSupplierSelected(selectedParams);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading transaction: {ex.Message}", Severity.Error);
        }
    }

    private async Task<string> GenerateVoucherNumberAsync(string prefix)
    {
        string dateStr = DateTime.Now.ToString("yyyyMMdd");
        string searchPattern = $"{prefix}-{dateStr}-";

        try
        {
            var transactions = await Http.GetFromJsonAsync<List<TransactionResponseModel>>(
                $"rest/v1/transactions?voucher_number=like.{searchPattern}*&order=voucher_number.desc&limit=1");

            int nextSeq = 1;
            if (transactions != null && transactions.Any() && !string.IsNullOrEmpty(transactions.First().voucher_number))
            {
                string lastVoucher = transactions.First().voucher_number!;
                string seqPart = lastVoucher.Substring(lastVoucher.LastIndexOf('-') + 1);
                if (int.TryParse(seqPart, out int currentSeq))
                {
                    nextSeq = currentSeq + 1;
                }
            }
            return $"{prefix}-{dateStr}-{nextSeq:D3}";
        }
        catch
        {
            return $"{prefix}-{dateStr}-001";
        }
    }

    private void OnSupplierSelected(IEnumerable<string> values)
    {
        _selectedContactId = values.FirstOrDefault() ?? string.Empty;
        _selectedContact = _suppliers.FirstOrDefault(c => c.Id == _selectedContactId);

        if (_selectedContact != null)
        {
            _currentAdvanceBalance = _selectedContact.AdvanceBalance;
            StateHasChanged();
        }
    }

    private async Task SaveAdvanceInAsync()
    {
        await _form.ValidateAsync();
        if (!_success) return;

        _isSaving = true;
        try
        {
            string ownerId = await UserContext.GetCurrentOwnerIdAsync();
            string staffId = await UserContext.GetCurrentStaffIdAsync();

            if (_isEditMode)
            {
                // ================== EDIT MODE (Revert Old -> Apply New) ==================

                // ၁။ ယခင် ခြံရှင်စာရင်းကို ပြန်ပြင်မည် (Advance In အဟောင်းကို ပယ်ဖျက်တာဖြစ်လို့ Advance Balance ထဲ ငွေပြန်ပေါင်းထည့်မည်)
                if (!string.IsNullOrEmpty(_originalContactId))
                {
                    var oldContact = await Http.GetFromJsonAsync<List<ContactBalanceModel>>($"rest/v1/contacts?id=eq.{_originalContactId}&select=advance_balance");
                    decimal oldBalance = oldContact?.FirstOrDefault()?.advance_balance ?? 0;
                    await Http.PatchAsJsonAsync($"rest/v1/contacts?id=eq.{_originalContactId}", new { advance_balance = oldBalance + _originalAmount });
                }

                // ၂။ ယခင် Wallet သို့ ပြန်ပြင်မည် (ငွေဝင်လာတာကို ပယ်ဖျက်တာဖြစ်လို့ Wallet ထဲက ငွေပြန်နှုတ်မည်)
                if (!string.IsNullOrEmpty(_originalWalletId))
                {
                    var oldWallet = await Http.GetFromJsonAsync<List<WalletBalanceModel>>($"rest/v1/wallets?id=eq.{_originalWalletId}&select=balance");
                    decimal oldWalletBal = oldWallet?.FirstOrDefault()?.balance ?? 0;
                    await Http.PatchAsJsonAsync($"rest/v1/wallets?id=eq.{_originalWalletId}", new { balance = oldWalletBal - _originalAmount });
                }

                // ၃။ အသစ်ရွေးချယ်ထားသော ခြံရှင်စာရင်းကို ငွေပြန်နှုတ်မည် (ငွေဆပ်တာဖြစ်လို့ Advance Balance လျော့မည်)
                var newContact = await Http.GetFromJsonAsync<List<ContactBalanceModel>>($"rest/v1/contacts?id=eq.{_selectedContactId}&select=advance_balance");
                decimal currentAdvance = newContact?.FirstOrDefault()?.advance_balance ?? 0;
                decimal updatedAdvance = currentAdvance - _amount;
                await Http.PatchAsJsonAsync($"rest/v1/contacts?id=eq.{_selectedContactId}", new { advance_balance = updatedAdvance });

                // ၄။ အသစ်ရွေးချယ်ထားသော Wallet မှ ပမာဏအသစ် ပေါင်းမည် (ငွေဝင်လာသောကြောင့်)
                var newWallet = await Http.GetFromJsonAsync<List<WalletBalanceModel>>($"rest/v1/wallets?id=eq.{_selectedWalletId}&select=balance");
                decimal currentWalletBal = newWallet?.FirstOrDefault()?.balance ?? 0;
                await Http.PatchAsJsonAsync($"rest/v1/wallets?id=eq.{_selectedWalletId}", new { balance = currentWalletBal + _amount });

                // ၅။ Transaction နှင့် Ledger များကို Update လုပ်မည်
                await Http.PatchAsJsonAsync($"rest/v1/transactions?id=eq.{EditTransactionId}", new
                {
                    contact_id = _selectedContactId,
                    wallet_id = _selectedWalletId,
                    total_amount = _amount,
                    paid_amount = _amount,
                    description = string.IsNullOrEmpty(_description) ? "Advance In Edit" : _description
                });

                await Http.PatchAsJsonAsync($"rest/v1/ledgers?transaction_id=eq.{EditTransactionId}", new
                {
                    contact_id = _selectedContactId,
                    debit_amount = _amount,
                    balance_after = updatedAdvance,
                    description = string.IsNullOrEmpty(_description) ? "Advance In Edit" : _description
                });

                Snackbar.Add("ပြင်ဆင်မှု အောင်မြင်ပါသည်။ ခြံရှင်နှင့် Wallet စာရင်းများကို ညှိပေးပြီးပါပြီ။", Severity.Success);
            }
            else
            {
                // ================== NEW CREATE MODE ==================

                var transaction = new
                {
                    owner_id = ownerId,
                    staff_id = staffId,
                    contact_id = _selectedContactId,
                    transaction_type = "AdvanceIn",
                    voucher_number = _voucherNumber,
                    total_amount = _amount,
                    paid_amount = _amount,
                    wallet_id = _selectedWalletId,
                    description = string.IsNullOrEmpty(_description) ? "Advance In (ကြိုတင်ငွေလက်ခံခြင်း)" : _description
                };

                var requestMessage = new HttpRequestMessage(HttpMethod.Post, "rest/v1/transactions")
                {
                    Content = JsonContent.Create(transaction)
                };
                requestMessage.Headers.Add("Prefer", "return=representation");

                var transResponse = await Http.SendAsync(requestMessage);

                if (transResponse.IsSuccessStatusCode)
                {
                    var createdTransactions = await transResponse.Content.ReadFromJsonAsync<List<TransactionResponseModel>>();
                    string? generatedTransactionId = createdTransactions?.FirstOrDefault()?.id;

                    // ပြန်ဆပ်ငွေဖြစ်သောကြောင့် လက်ကျန်ငွေ လျော့သွားပါမည်
                    decimal newAdvanceBalance = _currentAdvanceBalance - _amount;

                    var ledgerPayload = new
                    {
                        owner_id = ownerId,
                        staff_id = staffId,
                        contact_id = _selectedContactId,
                        transaction_id = generatedTransactionId,
                        voucher_number = _voucherNumber,
                        entry_type = "Debit",
                        debit_amount = _amount,
                        credit_amount = 0.00m,
                        balance_after = newAdvanceBalance,
                        balance_impact = "AdvanceIn",
                        description = string.IsNullOrEmpty(_description) ? "Advance In (ကြိုတင်ငွေလက်ခံခြင်း)" : _description
                    };

                    await Http.PostAsJsonAsync("rest/v1/ledgers", ledgerPayload);

                    await Http.PatchAsJsonAsync($"rest/v1/contacts?id=eq.{_selectedContactId}", new { advance_balance = newAdvanceBalance });

                    var voucherPayload = new
                    {
                        owner_id = ownerId,
                        staff_id = staffId,
                        voucher_number = _voucherNumber,
                        voucher_type = "AdvanceIn",
                        reference_id = generatedTransactionId
                    };
                    await Http.PostAsJsonAsync("rest/v1/vouchers", voucherPayload);

                    // Wallet လက်ကျန်ငွေ တိုးမြှင့်ခြင်း (ငွေဝင်လာသောကြောင့် Wallet ထဲ ပေါင်းမည်)
                    var selectedWallet = _wallets.FirstOrDefault(w => w.Id == _selectedWalletId);
                    if (selectedWallet != null)
                    {
                        decimal newWalletBalance = selectedWallet.Balance + _amount;
                        await Http.PatchAsJsonAsync($"rest/v1/wallets?id=eq.{selectedWallet.Id}", new { balance = newWalletBalance });
                    }

                    Snackbar.Add(Lang.GetString("Msg_Success") ?? "အောင်မြင်ပါသည်", Severity.Success);
                }
                else
                {
                    var err = await transResponse.Content.ReadAsStringAsync();
                    Snackbar.Add($"{Lang.GetString("Msg_Error")} {err}", Severity.Error);
                    return;
                }
            }

            _isSuccessCompleted = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Lang.GetString("Msg_Error")} {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void PrintVoucher()
    {
        Navigation.NavigateTo($"/print-voucher/{_voucherNumber}");
    }

    private void FinishTransaction()
    {
        // ခြံရှင်ငွေပြန်ဆပ်စာရင်းများ စာမျက်နှာ (သို့မဟုတ် သက်ဆိုင်ရာ List Page) သို့ သွားမည်
        Navigation.NavigateTo("/farm-owner-repayments");
    }

    private class TransactionModel
    {
        public string id { get; set; } = string.Empty;
        public string? voucher_number { get; set; }
        public string? contact_id { get; set; }
        public string? wallet_id { get; set; }
        public decimal total_amount { get; set; }
        public string? description { get; set; }
    }

    private class TransactionResponseModel
    {
        public string id { get; set; } = string.Empty;
        public string? voucher_number { get; set; }
    }

    private class ContactBalanceModel
    {
        public string id { get; set; } = string.Empty;
        public decimal advance_balance { get; set; }
    }

    private class WalletBalanceModel
    {
        public string id { get; set; } = string.Empty;
        public decimal balance { get; set; }
    }

    public void Dispose() => Lang.OnLanguageChanged -= StateHasChanged;
}