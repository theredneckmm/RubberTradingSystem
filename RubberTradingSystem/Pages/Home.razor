@page "/"
@using MudBlazor
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject LanguageService LangService
@implements IDisposable

<!-- Header Section -->
<div class="d-flex justify-space-between align-center mb-6">
    <div>
        <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 700;">@LangService.GetString("Dashboard")</MudText>
        <MudText Typo="Typo.subtitle1" Class="mud-text-secondary mt-1">
            @string.Format(LangService.GetString("DashboardSubtitle"), DateTime.Today.ToString("dd MMM yyyy"))
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.CloudOff" Size="Size.Medium" Class="rounded-pill px-4">
        @string.Format(LangService.GetString("OfflinePending"), _offlinePendingCount)
    </MudButton>
</div>

<!-- KPI Cards -->
<MudGrid Class="mb-6">
    <!-- Purchase -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="4" Class="pa-6 rounded-xl" Style="border-top: 4px solid var(--mud-palette-primary);">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mb-2">@LangService.GetString("TodayPurchaseWet")</MudText>
            <MudText Typo="Typo.h6" Color="Color.Primary" Style="font-weight: 400;"><b>@_todayPurchaseQty.ToString("N2")</b> @LangService.GetString("Pound")</MudText>
            <div class="d-flex align-center mt-3">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Small" Class="mr-1" />
                <MudText Typo="Typo.caption" Color="Color.Success">@LangService.GetString("PurchaseIncrease")</MudText>
            </div>
        </MudPaper>
    </MudItem>

    <!-- Rubber Sales (ရာဘာအရောင်းစာရင်း) -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="4" Class="pa-6 rounded-xl" Style="border-top: 4px solid var(--mud-palette-warning);">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mb-2">@LangService.GetString("TodaySalesTotal")</MudText>
            <MudText Typo="Typo.h6" Color="Color.Warning" Style="font-weight: 400;"><b>@_todaySaleQty.ToString("N2")</b> @LangService.GetString("Pound")</MudText>
            <div class="d-flex align-center mt-3">
                <MudIcon Icon="@Icons.Material.Filled.Sell" Color="Color.Warning" Size="Size.Small" Class="mr-1" />
                <MudText Typo="Typo.caption" Color="Color.Warning">ယနေ့ စုစုပေါင်းအရောင်း</MudText>
            </div>
        </MudPaper>
    </MudItem>

    <!-- Cash & Bank Balance -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="4" Class="pa-6 rounded-xl" Style="border-top: 4px solid var(--mud-palette-success);">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mb-2">@LangService.GetString("CashBankBalance")</MudText>
            <MudText Typo="Typo.h6" Color="Color.Success" Style="font-weight: 400;"><b>@_totalWalletBalance.ToString("N0")</b> @LangService.GetString("Kyat")</MudText>
            <div class="d-flex align-center mt-3">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Class="mud-text-secondary mr-1" Size="Size.Small" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@LangService.GetString("TotalKPayCash")</MudText>
            </div>
        </MudPaper>
    </MudItem>

    <!-- Warehouse Stock -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="4" Class="pa-6 rounded-xl" Style="border-top: 4px solid var(--mud-palette-secondary);">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mb-2">@LangService.GetString("WarehouseStock")</MudText>
            <MudText Typo="Typo.h6" Color="Color.Secondary" Style="font-weight: 400;"><b>@_totalStockQty.ToString("N2")</b> @LangService.GetString("Pound")</MudText>
            <div class="d-flex align-center mt-3">
                <MudIcon Icon="@Icons.Material.Filled.Warehouse" Class="mud-text-secondary mr-1" Size="Size.Small" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@LangService.GetString("TotalAllWarehouses")</MudText>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- Middle Section: Chart & Quick Actions -->
<MudGrid Class="mb-6">
    <!-- Chart -->
    <MudItem xs="12" md="8">
        <MudCard Elevation="4" Class="rounded-xl h-90 pa-2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" Style="font-weight: 600;">@LangService.GetString("WeeklyPurchaseTrend")</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@_series" XAxisLabels="@_xAxisLabels" Width="100%" Height="250px" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Quick Actions -->
    <MudItem xs="12" md="4">
        <MudCard Elevation="4" Class="rounded-xl h-100 pa-2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" Style="font-weight: 600;">@LangService.GetString("QuickActions")</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid Spacing="5">
                    <MudItem xs="6">
                        <MudButton Href="/rubber-purchase" Variant="Variant.Filled" Color="Color.Primary" Class="rounded-lg py-3 w-100 d-flex flex-column" Style="height: 90px;">
                            <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Size="Size.Medium" Class="mb-1" />
                            <MudText Typo="Typo.caption">@LangService.GetString("BuyWetRubber")</MudText>
                        </MudButton>
                    </MudItem>
                    <MudItem xs="6">
                        <MudButton Href="/rubber-sales" Variant="Variant.Filled" Color="Color.Error" Class="rounded-lg py-3 w-100 d-flex flex-column" Style="height: 90px;">
                            <MudIcon Icon="@Icons.Material.Filled.Sell" Size="Size.Medium" Class="mb-1" />
                            <MudText Typo="Typo.caption">@LangService.GetString("Menu_Sales")</MudText>
                        </MudButton>
                    </MudItem>
                    <MudItem xs="6">
                        <MudButton Href="/contacts" Variant="Variant.Outlined" Color="Color.Info" Class="rounded-lg py-3 w-100 d-flex flex-column" Style="height: 90px; border-width: 2px;">
                            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Medium" Class="mb-1" />
                            <MudText Typo="Typo.caption">@LangService.GetString("AddNewSupplier")</MudText>
                        </MudButton>
                    </MudItem>
                    <MudItem xs="6">
                        <MudButton Href="/forward-contract/create" Variant="Variant.Outlined" Color="Color.Warning" Class="rounded-lg py-3 w-100 d-flex flex-column" Style="height: 90px; border-width: 2px;">
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Medium" Class="mb-1" />
                            <MudText Typo="Typo.caption">@LangService.GetString("Menu_CreateContract")</MudText>
                        </MudButton>
                    </MudItem>
                    <MudItem xs="6">
                        <MudButton Href="/expenses" Variant="Variant.Filled" Color="Color.Surface" Class="rounded-lg py-3 w-100 d-flex flex-column" Style="height: 90px;">
                            <MudIcon Icon="@Icons.Material.Filled.MoneyOff" Size="Size.Medium" Class="mb-1" />
                            <MudText Typo="Typo.caption">@LangService.GetString("RecordExpense")</MudText>
                        </MudButton>
                    </MudItem>
                    <MudItem xs="6">
                        <MudButton Href="/truck-expenses" Variant="Variant.Filled" Color="Color.Secondary" Class="rounded-lg py-3 w-100 d-flex flex-column" Style="height: 90px;">
                            <MudIcon Icon="@Icons.Material.Filled.LocalGasStation" Size="Size.Medium" Class="mb-1" />
                            <MudText Typo="Typo.caption">@LangService.GetString("Menu_Fuel")</MudText>
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<!-- Bottom Section: Transactions & Alerts -->
<MudGrid>
    <!-- Recent Transactions -->
    <MudItem xs="12" md="8">
        <MudCard Elevation="4" Class="rounded-xl h-100 pa-2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" Style="font-weight: 600;">@LangService.GetString("RecentTransactions")</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudTable Items="@_recentTransactions" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Loading="@_isLoading">
                    <HeaderContent>
                        <MudTh>@LangService.GetString("Voucher")</MudTh>
                        <MudTh>@LangService.GetString("NameDescription")</MudTh>
                        <MudTh>@LangService.GetString("Amount")</MudTh>
                        <MudTh>@LangService.GetString("Status")</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Voucher"><MudText Color="Color.Primary" Style="font-weight: 600;">@context.voucher_number</MudText></MudTd>
                        <MudTd DataLabel="Name">@context.contact_name</MudTd>
                        <MudTd DataLabel="Amount">@context.total_amount.ToString("N0")</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@context.sync_status</MudChip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Smart Alerts -->
    <MudItem xs="12" md="4">
        <MudCard Elevation="4" Class="rounded-xl h-100 pa-2">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Error" Class="mr-2" />
                        <MudText Typo="Typo.h6" Color="Color.Error" Style="font-weight: 600;">@LangService.GetString("Alerts")</MudText>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                <MudList T="string" DisablePadding="true">
                    <MudListItem Icon="@Icons.Material.Filled.Warning" IconColor="Color.Warning">
                        <MudText Typo="Typo.body2">@LangService.GetString("AdvancePaymentAlert")</MudText>
                    </MudListItem>
                    <MudDivider />
                    <MudListItem Icon="@Icons.Material.Filled.Inventory" IconColor="Color.Error">
                        <MudText Typo="Typo.body2">@LangService.GetString("LowStockAlert")</MudText>
                    </MudListItem>
                </MudList>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private bool _isLoading = false;
    private decimal _todayPurchaseQty = 0m;
    private decimal _todaySaleQty = 0m;
    private decimal _totalWalletBalance = 0m;
    private decimal _totalStockQty = 0m;
    private int _offlinePendingCount = 0;

    private List<RecentTxModel> _recentTransactions = new();
    private List<ChartSeries<double>> _series = new();
    private string[] _xAxisLabels = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

    private void UpdateUI() => InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += UpdateUI;
        await LoadRealDashboardDataAsync();
    }

    public void Dispose() => LangService.OnLanguageChanged -= UpdateUI;

    private async Task LoadRealDashboardDataAsync()
    {
        _isLoading = true;
        try
        {
            var txs = await Http.GetFromJsonAsync<List<TransactionRaw>>("rest/v1/transactions?select=*&order=created_at.desc") ?? new();
            var contacts = await Http.GetFromJsonAsync<List<ContactRaw>>("rest/v1/contacts?select=id,name") ?? new();

            string todayStr = DateTime.Today.ToString("yyyy-MM-dd");

            // Nullable quantities များကို 0m သို့ ညှိ၍ တွက်ချက်ခြင်း
            var todayTxs = txs.Where(t => t.created_at.ToString("yyyy-MM-dd") == todayStr).ToList();
            _todayPurchaseQty = todayTxs.Where(t => t.transaction_type == "Purchase").Sum(t => t.quantity ?? 0m);
            _todaySaleQty = todayTxs.Where(t => t.transaction_type == "Sale" || t.transaction_type == "ForwardContractSale").Sum(t => t.quantity ?? 0m);

            _offlinePendingCount = txs.Count(t => t.sync_status != "Synced");

            _recentTransactions = txs.Take(5).Select(t => new RecentTxModel
            {
                voucher_number = t.voucher_number ?? "N/A",
                contact_name = contacts.FirstOrDefault(c => c.id == t.contact_id)?.name ?? t.transaction_type,
                total_amount = t.total_amount,
                sync_status = t.sync_status ?? "Synced"
            }).ToList();

            // Wallets မှ စုစုပေါင်း လက်ကျန်ငွေ
            var wallets = await Http.GetFromJsonAsync<List<WalletModel>>("rest/v1/wallets?select=balance") ?? new();
            _totalWalletBalance = wallets.Sum(w => w.Balance);

            // စုစုပေါင်း Stock ပမာဏ (Total Purchase - Total Sale)
            decimal totalPurchased = txs.Where(t => t.transaction_type == "Purchase").Sum(t => t.quantity ?? 0m);
            decimal totalSold = txs.Where(t => t.transaction_type == "Sale" || t.transaction_type == "ForwardContractSale").Sum(t => t.quantity ?? 0m);
            _totalStockQty = totalPurchased - totalSold;

            // Chart Data (ပြီးခဲ့သော ၇ ရက်အတွင်း ဝယ်ယူမှု Trend)
            var weeklyPurchases = new double[7];
            for (int i = 6; i >= 0; i--)
            {
                var targetDate = DateTime.Today.AddDays(-i);
                weeklyPurchases[6 - i] = (double)txs
                    .Where(t => t.transaction_type == "Purchase" && t.created_at.Date == targetDate.Date)
                    .Sum(t => t.quantity ?? 0m);
            }

            _series = new List<ChartSeries<double>>()
            {
                new ChartSeries<double>() { Name = "ဝယ်ယူမှုပမာဏ (ပေါင်)", Data = weeklyPurchases }
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Dashboard Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class TransactionRaw
    {
        public string id { get; set; } = string.Empty;
        public string? voucher_number { get; set; }
        public string transaction_type { get; set; } = string.Empty;
        public string? contact_id { get; set; }
        public decimal total_amount { get; set; }
        public decimal? quantity { get; set; } // Nullable ဖြင့် Error တက်ခြင်းကို ကာကွယ်ထားသည်
        public string? sync_status { get; set; }
        public DateTime created_at { get; set; }
    }

    private class ContactRaw
    {
        public string id { get; set; } = string.Empty;
        public string name { get; set; } = string.Empty;
    }

    private class RecentTxModel
    {
        public string voucher_number { get; set; } = string.Empty;
        public string contact_name { get; set; } = string.Empty;
        public decimal total_amount { get; set; }
        public string sync_status { get; set; } = string.Empty;
    }
}