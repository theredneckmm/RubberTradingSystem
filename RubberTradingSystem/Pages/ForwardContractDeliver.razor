@page "/forward-contract/deliveries"
@using MudBlazor
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject LanguageService LangService
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-6">
    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4 font-weight-bold">
        ကြိုပွိုင့် ရာဘာပေးသွင်းမှု မှတ်တမ်းများ (Forward Contract Deliveries)
    </MudText>

    <MudTable Items="@_deliveries" Dense="true" Hover="true" Bordered="true" Striped="true"
              Filter="new Func<DeliveryListModel,bool>(FilterFunc)" Loading="@_isLoading">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="ဘောင်ချာ (သို့) ကုန်သည်အမည်ဖြင့် ရှာရန်..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium" Class="mt-0" Immediate="true" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>ရက်စွဲ</MudTh>
            <MudTh>ဘောင်ချာအမှတ်</MudTh>
            <MudTh>ကုန်သည်အမည်</MudTh>
            <MudTh>ရာဘာအမျိုးအစား</MudTh>
            <MudTh Style="text-align: right;">ပေးသွင်းပိဿာချိန်</MudTh>
            <MudTh Style="text-align: right;">သဘောတူဈေး</MudTh>
            <MudTh Style="text-align: right;">စုစုပေါင်းတန်ဖိုး</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ရက်စွဲ">@context.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</MudTd>
            <MudTd DataLabel="ဘောင်ချာအမှတ်"><b>@context.VoucherNumber</b></MudTd>
            <MudTd DataLabel="ကုန်သည်အမည်">@context.MerchantName</MudTd>
            <MudTd DataLabel="ရာဘာအမျိုးအစား">@context.RubberTypeName</MudTd>
            <MudTd DataLabel="ပေးသွင်းပိဿာချိန်" Style="text-align: right;">@context.Quantity.ToString("N2")</MudTd>
            <MudTd DataLabel="သဘောတူဈေး" Style="text-align: right;">@context.AgreedPrice.ToString("N0")</MudTd>
            <MudTd DataLabel="စုစုပေါင်းတန်ဖိုး" Style="text-align: right;">@context.TotalAmount.ToString("N0")</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 20, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private List<DeliveryListModel> _deliveries = new();

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += StateHasChanged;
        await LoadDeliveriesAsync();
    }

    public void Dispose()
    {
        LangService.OnLanguageChanged -= StateHasChanged;
    }

    private async Task LoadDeliveriesAsync()
    {
        _isLoading = true;
        try
        {
            // transaction_type ကို 'ForwardContractSale' အဖြစ် သိမ်းဆည်းခဲ့သော မှတ်တမ်းများကို ဆွဲထုတ်မည်
            string query = "rest/v1/transactions?transaction_type=eq.ForwardContractSale&select=id,created_at,voucher_number,quantity,agreed_price,total_amount,contacts(name),rubber_types(name,grade)&order=created_at.desc";

            var rawData = await Http.GetFromJsonAsync<List<TransactionRawModel>>(query);

            if (rawData != null)
            {
                _deliveries = rawData.Select(x => new DeliveryListModel
                {
                    Id = x.id,
                    CreatedAt = x.created_at,
                    VoucherNumber = x.voucher_number ?? "-",
                    MerchantName = x.contacts?.name ?? "N/A",
                    RubberTypeName = x.rubber_types != null ? $"{x.rubber_types.name} ({x.rubber_types.grade})" : "-",
                    Quantity = x.quantity,
                    AgreedPrice = x.agreed_price,
                    TotalAmount = x.total_amount
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"မှတ်တမ်းများ ရယူရာတွင် အမှားအယွင်းရှိပါသည်: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool FilterFunc(DeliveryListModel element) => FilterFuncLogic(element, _searchString);

    private bool FilterFuncLogic(DeliveryListModel element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        if (element.VoucherNumber.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (element.MerchantName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }

    // --- Models ---
    private class DeliveryListModel
    {
        public string Id { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public string VoucherNumber { get; set; } = string.Empty;
        public string MerchantName { get; set; } = string.Empty;
        public string RubberTypeName { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
        public decimal AgreedPrice { get; set; }
        public decimal TotalAmount { get; set; }
    }

    private class TransactionRawModel
    {
        public string id { get; set; } = string.Empty;
        public DateTime created_at { get; set; }
        public string? voucher_number { get; set; }
        public decimal quantity { get; set; }
        public decimal agreed_price { get; set; }
        public decimal total_amount { get; set; }
        public ContactObj? contacts { get; set; }
        public RubberObj? rubber_types { get; set; }
    }

    private class ContactObj { public string name { get; set; } = string.Empty; }
    private class RubberObj { public string name { get; set; } = string.Empty; public string grade { get; set; } = string.Empty; }
}