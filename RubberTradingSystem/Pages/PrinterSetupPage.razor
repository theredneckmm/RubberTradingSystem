@page "/settings/printer"
@using MudBlazor
@using RubberTradingSystem.Components
@using RubberTradingSystem.Models.Printing
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject LanguageService LangService
@inject UserContextService UserContext
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-6">
    <!-- Header Title -->
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5" Style="color: #4caf50; font-weight: 700;">
            @LangService.GetString("Title_PrinterSetup")
        </MudText>
    </div>

    <EditForm Model="@_model" OnValidSubmit="SaveSettingsAsync">
        <DataAnnotationsValidator />

        <MudGrid Spacing="4">
            <!-- Printer & Voucher Selection -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="3" Style="background-color: #1e293b; height: 100%;">
                    <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">
                        <b>@LangService.GetString("Section_DeviceConfig")</b>
                    </MudText>

                    <MudGrid Spacing="3">
                        <!-- Printer Selection -->
                        <MudItem xs="12">
                            <MudSelect T="string" @bind-Value="_model.SelectedPrinter" Label="@LangService.GetString("Lbl_SelectPrinter")"
                                       Variant="Variant.Outlined" Dense="true">
                                <MudSelectItem Value="@("Microsoft Print to PDF")">Microsoft Print to PDF (Default)</MudSelectItem>
                                <MudSelectItem Value="@("POS Thermal Printer 80mm")">POS Thermal Printer (80mm)</MudSelectItem>
                                <MudSelectItem Value="@("Network Printer (LAN)")">Network Printer (LAN)</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <!-- Voucher Size Selection -->
                        <MudItem xs="12">
                            <MudSelect T="string" Value="_model.PaperSize" ValueChanged="OnPaperSizeChanged" Label="@LangService.GetString("Lbl_VoucherSize")"
                                       Variant="Variant.Outlined" Dense="true" ToStringFunc="@GetPaperSizeDisplayName">
                                <MudSelectItem Value="@("A4_Portrait")">A4 Size (Portrait - 210 x 297 mm)</MudSelectItem>
                                <MudSelectItem Value="@("A4_Landscape")">A4 Size (Landscape - 297 x 210 mm)</MudSelectItem>
                                <MudSelectItem Value="@("A5_Portrait")">A5 Size (Portrait - 148 x 210 mm)</MudSelectItem>
                                <MudSelectItem Value="@("A5_Landscape")">A5 Size (Landscape - 210 x 148 mm)</MudSelectItem>
                                <MudSelectItem Value="@("A6_Portrait")">A6 Size (Portrait - 105 x 148 mm)</MudSelectItem>
                                <MudSelectItem Value="@("A6_Landscape")">A6 Size (Landscape - 148 x 105 mm)</MudSelectItem>
                                <MudSelectItem Value="@("Thermal_80mm")">POS Thermal Receipt (80 x 200 mm)</MudSelectItem>
                                <MudSelectItem Value="@("Custom")">Custom Size (စိတ်ကြိုက်အလယ်အလတ်)</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <!-- Live Dimension Indicator (Always Visible for All Paper Types) -->
                        <MudItem xs="12">
                            <MudPaper Class="pa-3" Elevation="0" Style="background-color: #0f172a; border: 1px dashed #475569;">
                                <div class="d-flex justify-space-between align-center">
                                    <MudText Typo="Typo.body2" Color="Color.Info">
                                        <b>လက်ရှိ စာရွက်အတိုင်းအတာ (Dimensions):</b>
                                    </MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                        <b>@_model.CustomWidth mm</b> × <b>@_model.CustomHeight mm</b>
                                    </MudChip>
                                </div>
                            </MudPaper>
                        </MudItem>

                        <!-- Custom Size Inputs (Only editable when Custom is selected) -->
                        @if (_model.PaperSize == "Custom")
                        {
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="int" @bind-Value="_model.CustomWidth" Label="@LangService.GetString("Lbl_WidthMM")"
                                                 Variant="Variant.Outlined" Dense="true" Min="30" Max="500" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="int" @bind-Value="_model.CustomHeight" Label="@LangService.GetString("Lbl_HeightMM")"
                                                 Variant="Variant.Outlined" Dense="true" Min="30" Max="1000" />
                            </MudItem>
                        }

                        <!-- Set as Default Checkbox -->
                        <MudItem xs="12">
                            <MudCheckBox T="bool" @bind-Value="_model.IsDefault" Label="@LangService.GetString("Lbl_SetAsDefault")"
                                         Color="Color.Success" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <!-- Header & Footer Customization -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="3" Style="background-color: #1e293b; height: 100%;">
                    <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">
                        <b>@LangService.GetString("Section_HeaderFooter")</b>
                    </MudText>

                    <MudGrid Spacing="3">
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.HeaderTitle" Label="@LangService.GetString("Lbl_HeaderTitle")"
                                          Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.HeaderAddress" Label="@LangService.GetString("Lbl_HeaderAddress")"
                                          Variant="Variant.Outlined" Dense="true" Lines="2" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.FooterNote" Label="@LangService.GetString("Lbl_FooterNote")"
                                          Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <!-- Action Buttons -->
            <MudItem xs="12" Class="d-flex justify-end gap-3 mt-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Large" StartIcon="@Icons.Material.Filled.Preview" OnClick="OpenTestPagePreview">
                    Test Page (စမ်းသပ်ကြည့်မည်)
                </MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Style="background-color: #22c55e; color: white;"
                           Size="Size.Large" StartIcon="@Icons.Material.Filled.Save" Disabled="_isSaving">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <text>@LangService.GetString("Btn_SaveSettings")</text>
                    }
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudContainer>

@code {
    private PrinterSetupModel _model = new();
    private bool _isSaving = false;
    private string? _existingId = null;

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += StateHasChanged;
        await LoadSettingsAsync();
    }

    public void Dispose() => LangService.OnLanguageChanged -= StateHasChanged;

    private void OnPaperSizeChanged(string selectedSize)
    {
        _model.PaperSize = selectedSize;
        // Automatically update width and height based on selection
        switch (selectedSize)
        {
            case "A4_Portrait": _model.CustomWidth = 210; _model.CustomHeight = 297; break;
            case "A4_Landscape": _model.CustomWidth = 297; _model.CustomHeight = 210; break;
            case "A5_Portrait": _model.CustomWidth = 148; _model.CustomHeight = 210; break;
            case "A5_Landscape": _model.CustomWidth = 210; _model.CustomHeight = 148; break;
            case "A6_Portrait": _model.CustomWidth = 105; _model.CustomHeight = 148; break;
            case "A6_Landscape": _model.CustomWidth = 148; _model.CustomHeight = 105; break;
            case "Thermal_80mm": _model.CustomWidth = 80; _model.CustomHeight = 200; break;
        }
    }

    private string GetPaperSizeDisplayName(string sizeKey) => sizeKey switch
    {
        "A4_Portrait" => "A4 (Portrait)",
        "A4_Landscape" => "A4 (Landscape)",
        "A5_Portrait" => "A5 (Portrait)",
        "A5_Landscape" => "A5 (Landscape)",
        "A6_Portrait" => "A6 (Portrait)",
        "A6_Landscape" => "A6 (Landscape)",
        "Thermal_80mm" => "POS Thermal 80mm",
        "Custom" => "Custom Size",
        _ => sizeKey
    };

    private async Task LoadSettingsAsync()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<List<PrinterSetupModel>>("rest/v1/printer_settings?select=*&limit=1");
            if (settings != null && settings.Any())
            {
                _model = settings.First();
                _existingId = _model.id;
                return;
            }
        }
        catch { }
    }

    private async Task SaveSettingsAsync()
    {
        _isSaving = true;
        try
        {
            var ownerId = await UserContext.GetCurrentOwnerIdAsync();
            var staffId = await UserContext.GetCurrentStaffIdAsync();

            var payload = new
            {
                owner_id = ownerId,
                staff_id = string.IsNullOrEmpty(staffId) ? null : staffId,
                selected_printer = _model.SelectedPrinter,
                voucher_size = _model.PaperSize,
                custom_width = _model.CustomWidth,
                custom_height = _model.CustomHeight,
                is_default = _model.IsDefault,
                header_title = _model.HeaderTitle,
                header_address = _model.HeaderAddress,
                footer_note = _model.FooterNote,
                sync_status = "Synced"
            };

            HttpResponseMessage resp;
            if (string.IsNullOrEmpty(_existingId))
            {
                var reqMsg = new HttpRequestMessage(HttpMethod.Post, "rest/v1/printer_settings")
                {
                    Content = JsonContent.Create(payload)
                };
                reqMsg.Headers.Add("Prefer", "return=representation");
                resp = await Http.SendAsync(reqMsg);

                if (resp.IsSuccessStatusCode)
                {
                    var created = await resp.Content.ReadFromJsonAsync<List<PrinterSetupModel>>();
                    _existingId = created?.FirstOrDefault()?.id;
                }
            }
            else
            {
                resp = await Http.PatchAsync($"rest/v1/printer_settings?id=eq.{_existingId}", JsonContent.Create(payload));
            }

            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("ပရင်တာနှင့် ဘောက်ချာ ဆက်တင်များကို အောင်မြင်စွာ သိမ်းဆည်းပြီးပါပြီ။", Severity.Success);
            }
            else
            {
                Snackbar.Add("Database သို့ သိမ်းဆည်းရာတွင် အမှားအယွင်းရှိပါသည်။", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task OpenTestPagePreview()
    {
        var testDocument = new PrintDocumentModel
        {
            Title = "Print Test Page Preview",
            DocumentType = "Test Voucher",
            PaperSize = _model.PaperSize,
            CustomWidth = _model.CustomWidth,
            CustomHeight = _model.CustomHeight,
            HeaderTitle = string.IsNullOrEmpty(_model.HeaderTitle) ? "RUBBER TRADING SYSTEM" : _model.HeaderTitle,
            HeaderAddress = string.IsNullOrEmpty(_model.HeaderAddress) ? "No. 123, Main Road, Yangon" : _model.HeaderAddress,
            FooterNote = string.IsNullOrEmpty(_model.FooterNote) ? "စမ်းသပ်မှုအောင်မြင်ပါသည်။ ကျေးဇူးတင်ပါသည်။" : _model.FooterNote,
            
            Fields = new List<PrintFieldModel>
            {
                new() { Label = "Voucher No", Value = "TEST-001" },
                new() { Label = "Date", Value = DateTime.Today.ToString("dd/MM/yyyy") },
                new() { Label = "Customer", Value = "ဦးဘေဝ (စမ်းသပ်ဝယ်ယူသူ)" },
                new() { Label = "Grade", Value = "RSS-3 Standard" }
            },

            Rows = new List<PrintRowModel>
            {
                new() { Description = "ရော်ဘာအမျိုးအစား RSS-3", Quantity = 500, Price = 4500, Amount = 2250000 },
                new() { Description = "ရော်ဘာအမျိုးအစား MTR", Quantity = 300, Price = 4000, Amount = 1200000 }
            }
        };

        var parameters = new DialogParameters
        {
            ["Document"] = testDocument
        };

        var options = new DialogOptions 
        { 
            MaxWidth = MaxWidth.Large, 
            FullWidth = true, 
            CloseButton = true,
            CloseOnEscapeKey = true,
            Position = DialogPosition.Center
        };

        await DialogService.ShowAsync<PrintPreviewDialog>("Test Page Preview", parameters, options);
    }

    public class PrinterSetupModel
    {
        public string? id { get; set; }
        public string SelectedPrinter { get; set; } = "Microsoft Print to PDF";
        public string PaperSize { get; set; } = "A6_Portrait";
        public int CustomWidth { get; set; } = 105;
        public int CustomHeight { get; set; } = 148;
        public bool IsDefault { get; set; } = true;
        public string HeaderTitle { get; set; } = string.Empty;
        public string HeaderAddress { get; set; } = string.Empty;
        public string FooterNote { get; set; } = string.Empty;
    }
}