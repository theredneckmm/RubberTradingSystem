    private async Task<decimal> GetLatestBalanceForContact(string contactId)
    {
        try
        {
            var ledgers = await Http.GetFromJsonAsync<List<LedgerModel>>($"rest/v1/ledgers?contact_id=eq.{contactId}&order=created_at.desc&limit=1");
            return ledgers?.FirstOrDefault()?.balance_after ?? 0m;
        }
        catch
        {
            return 0m;
        }
    }

