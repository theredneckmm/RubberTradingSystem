@page "/reports/forward-contracts"
@using MudBlazor
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject LanguageService LangService
@inject IJSRuntime JS
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-6">
    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">@LangService.GetString("Title_ForwardContractReport")</MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid AlignItems="Center">
            <MudItem xs="12" sm="4" md="4"><MudDatePicker Label="@LangService.GetString("Lbl_FromDate")" @bind-Date="_fromDate" Variant="Variant.Outlined" Dense="true" Clearable="true" /></MudItem>
            <MudItem xs="12" sm="4" md="4"><MudDatePicker Label="@LangService.GetString("Lbl_ToDate")" @bind-Date="_toDate" Variant="Variant.Outlined" Dense="true" Clearable="true" /></MudItem>
            <MudItem xs="12" sm="4" md="4" Class="d-flex gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="LoadDataAsync">@LangService.GetString("Btn_Search")</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" StartIcon="@Icons.Material.Filled.TableChart" OnClick="ExportToExcelAsync">Excel</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable Items="@_items" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@_isLoading" Elevation="2">
        <HeaderContent>
            <MudTh>@LangService.GetString("Th_BuyerName")</MudTh>
            <MudTh>@LangService.GetString("Th_ContractQty")</MudTh>
            <MudTh>@LangService.GetString("Th_DeliveredQty")</MudTh>
            <MudTh>@LangService.GetString("Th_RemainingQty")</MudTh>
            <MudTh>@LangService.GetString("Th_TotalAmount")</MudTh>
            <MudTh>@LangService.GetString("Th_Status")</MudTh>
            <MudTh>@LangService.GetString("Th_Date")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><b>@context.merchant_name</b></MudTd>
            <MudTd>@context.contract_quantity.ToString("N2")</MudTd>
            <MudTd>@context.delivered_quantity.ToString("N2")</MudTd>
            <MudTd><b>@context.remaining_quantity.ToString("N2")</b></MudTd>
            <MudTd><b>@context.total_advance_amount.ToString("N0")</b></MudTd>
            <MudTd><MudChip T="string" Color="@(context.status == "Active" ? Color.Warning : Color.Success)" Size="Size.Small">@context.status</MudChip></MudTd>
            <MudTd>@context.created_at.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
        </RowTemplate>
        <PagerContent><MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" /></PagerContent>
    </MudTable>
</MudContainer>

@code {
    private DateTime? _fromDate = DateTime.Today.AddDays(-30);
    private DateTime? _toDate = DateTime.Today;
    private bool _isLoading = false;
    private List<ReportModel> _items = new();

    protected override async Task OnInitializedAsync() { LangService.OnLanguageChanged += StateHasChanged; await LoadDataAsync(); }
    public void Dispose() => LangService.OnLanguageChanged -= StateHasChanged;

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            string query = "rest/v1/forward_contracts?select=id,contract_quantity,delivered_quantity,total_advance_amount,status,created_at,contacts(name)";
            if (_fromDate.HasValue) query += $"&created_at=gte.{_fromDate.Value:yyyy-MM-dd}";
            if (_toDate.HasValue) query += $"&created_at=lte.{_toDate.Value.AddDays(1):yyyy-MM-dd}";
            query += "&order=created_at.desc";
            var raw = await Http.GetFromJsonAsync<List<RawModel>>(query) ?? new();
            _items = raw.Select(x => new ReportModel { id = x.id, merchant_name = x.contacts?.name ?? "N/A", contract_quantity = x.contract_quantity, delivered_quantity = x.delivered_quantity, total_advance_amount = x.total_advance_amount, status = x.status, created_at = x.created_at }).ToList();
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private async Task ExportToExcelAsync()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Buyer,Contract Qty,Delivered Qty,Remaining Qty,Advance Amount,Status,Date");
        foreach (var i in _items) csv.AppendLine($"\"{i.merchant_name}\",{i.contract_quantity},{i.delivered_quantity},{i.remaining_quantity},{i.total_advance_amount},\"{i.status}\",\"{i.created_at:yyyy-MM-dd}\"");
        await JS.InvokeVoidAsync("downloadFileFromBytes", $"Forward_Contracts_{DateTime.Now:yyyyMMdd}.csv", "text/csv", System.Text.Encoding.UTF8.GetBytes(csv.ToString()));
    }

    public class ReportModel { public string id { get; set; } = string.Empty; public string merchant_name { get; set; } = string.Empty; public decimal contract_quantity { get; set; } public decimal delivered_quantity { get; set; } public decimal remaining_quantity => contract_quantity - delivered_quantity; public decimal total_advance_amount { get; set; } public string status { get; set; } = "Active"; public DateTime created_at { get; set; } }
    private class RawModel { public string id { get; set; } = string.Empty; public decimal contract_quantity { get; set; } public decimal delivered_quantity { get; set; } public decimal total_advance_amount { get; set; } public string status { get; set; } = "Active"; public DateTime created_at { get; set; } public ContactObj? contacts { get; set; } }
    private class ContactObj { public string name { get; set; } = string.Empty; }
}