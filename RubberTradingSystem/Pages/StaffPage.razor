@page "/staff"
@using MudBlazor
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject LanguageService LangService
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-6">
    <!-- Header Title -->
    <MudText Typo="Typo.h5" Style="color: #4caf50; font-weight: 700;" Class="mb-4">
        @LangService.GetString("Title_StaffList")
    </MudText>

    <!-- Search & Filter Paper -->
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="background-color: #1e293b;">
        <MudGrid AlignItems="Center">
            <MudItem xs="12" sm="8" md="6">
                <MudTextField @bind-Value="_searchString" Placeholder="@LangService.GetString("Placeholder_SearchStaff")"
                              Variant="Variant.Outlined" Dense="true" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="4" md="6">
                <MudButton Variant="Variant.Filled" Style="background-color: #22c55e; color: white;" FullWidth="true" OnClick="LoadStaffDataAsync">
                    @LangService.GetString("Btn_Search")
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Table with Clear Row Selection Highlighting -->
    <MudTable Items="@_filteredStaff" Dense="true" Hover="true" Bordered="true" Striped="true"
              Elevation="2" Loading="@_isLoading" T="StaffModel"
              @bind-SelectedItem="_selectedStaff" RowClassFunc="SelectedRowClassFunc">
        <HeaderContent>
            <MudTh>@LangService.GetString("Th_Name")</MudTh>
            <MudTh>@LangService.GetString("Th_Position")</MudTh>
            <MudTh>@LangService.GetString("Th_Phone")</MudTh>
            <MudTh>@LangService.GetString("Th_BasicSalary")</MudTh>
            <MudTh>@LangService.GetString("Th_Status")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name"><b>@context.name</b></MudTd>
            <MudTd DataLabel="Position">@context.position</MudTd>
            <MudTd DataLabel="Phone">@(context.phone ?? "-")</MudTd>
            <MudTd DataLabel="Salary"><b>@context.basic_salary.ToString("N0")</b> MMK</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@(context.status == "Active" ? Color.Success : Color.Error)" Size="Size.Small">
                    @context.status
                </MudChip>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>

    <!-- Bottom Action Buttons -->
    <MudPaper Class="pa-4 mt-4 d-flex justify-end gap-3" Elevation="2" Style="background-color: #1e293b;">
        <MudButton Variant="Variant.Filled" Style="background-color: #22c55e; color: white;"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="NavigateToAdd">
            @LangService.GetString("Btn_AddStaffNew")
        </MudButton>
        <MudButton Variant="Variant.Filled" Style="background-color: #334155; color: #cbd5e1;"
                   StartIcon="@Icons.Material.Filled.Edit" Disabled="@(_selectedStaff == null)" OnClick="NavigateToEdit">
            @LangService.GetString("Btn_Edit")
        </MudButton>
        <MudButton Variant="Variant.Filled" Style="background-color: #334155; color: #f87171;"
                   StartIcon="@Icons.Material.Filled.Delete" Disabled="@(_selectedStaff == null)" OnClick="DeleteStaffAsync">
            @LangService.GetString("Btn_Delete")
        </MudButton>
    </MudPaper>
</MudContainer>

<!-- Custom Styling for Selected Row to Stand Out Clearly -->
<style>
    .selected-row {
        background-color: #1b5e20 !important; /* Dark Green highlight */
        color: #ffffff !important;
    }

        .selected-row td {
            color: #ffffff !important;
        }
</style>

@code {
    private bool _isLoading = false;
    private string _searchString = "";
    private List<StaffModel> _staffList = new();
    private StaffModel? _selectedStaff;

    private IEnumerable<StaffModel> _filteredStaff => string.IsNullOrWhiteSpace(_searchString)
        ? _staffList
        : _staffList.Where(x => x.name.Contains(_searchString, StringComparison.OrdinalIgnoreCase) || x.position.Contains(_searchString, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += StateHasChanged;
        await LoadStaffDataAsync();
    }

    public void Dispose() => LangService.OnLanguageChanged -= StateHasChanged;

    private async Task LoadStaffDataAsync()
    {
        _isLoading = true;
        try
        {
            _staffList = await Http.GetFromJsonAsync<List<StaffModel>>("rest/v1/staff?select=*&order=created_at.desc") ?? new();
            _selectedStaff = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string SelectedRowClassFunc(StaffModel staff, int rowNumber)
    {
        if (_selectedStaff != null && _selectedStaff.id == staff.id)
        {
            return "selected-row";
        }
        return string.Empty;
    }

    private void NavigateToAdd() => Navigation.NavigateTo("/employee/add");
    private void NavigateToEdit()
    {
        if (_selectedStaff != null)
        {
            Navigation.NavigateTo($"/employee/add?id={_selectedStaff.id}");
        }
    }

    private async Task DeleteStaffAsync()
    {
        if (_selectedStaff == null) return;
        try
        {
            var resp = await Http.DeleteAsync($"rest/v1/staff?id=eq.{_selectedStaff.id}");
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("ဝန်ထမ်းအချက်အလက် ဖျက်ဆီးပြီးပါပြီ။", Severity.Success);
                await LoadStaffDataAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    public class StaffModel
    {
        public string id { get; set; } = string.Empty;
        public string name { get; set; } = string.Empty;
        public string position { get; set; } = string.Empty;
        public string? phone { get; set; } =string.Empty;
        public decimal basic_salary { get; set; }
        public string status { get; set; } = "Active";
    }
}