@page "/other-outcomes"
@using MudBlazor
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject LanguageService LangService
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-6">
    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4 font-weight-bold">
        @LangService.GetString("Outcome_ListTitle")
    </MudText>

    <MudTable Items="@_items" Dense="true" Hover="true" Bordered="true" Striped="true"
              Filter="new Func<OtherOutcomeModel,bool>(FilterFunc)"
              @bind-SelectedItem="_selectedItem" RowClassFunc="SelectedRowClassFunc" Elevation="2">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="@LangService.GetString("Outcome_SearchPlaceholder")"
                          Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-0" Clearable="true"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@LangService.GetString("Outcome_ColDesc")</MudTh>
            <MudTh>@LangService.GetString("Outcome_ColAmount")</MudTh>
            <MudTh>@LangService.GetString("Outcome_ColPaymentMethod")</MudTh>
            <MudTh>@LangService.GetString("Outcome_ColDate")</MudTh>
            <MudTh>@LangService.GetString("Outcome_ColNote")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Description"><b>@context.description</b></MudTd>
            <MudTd DataLabel="Amount"><b style="color: var(--mud-palette-error-text);">@context.amount.ToString("N0")</b></MudTd>
            <MudTd DataLabel="Payment Method">
                <MudChip T="string" Color="@(context.payment_method.Contains("Cash") ? Color.Success : Color.Info)" Size="Size.Small">
                    @context.payment_method
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Date">@context.expense_date.ToString("dd/MM/yyyy")</MudTd>
            <MudTd DataLabel="Note">@context.note</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>

    <MudPaper Class="d-flex justify-end pa-4 mt-4" Elevation="2">
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog" Class="mr-2">
            @LangService.GetString("Outcome_AddButton")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit" Disabled="@(_selectedItem == null)" OnClick="OpenEditDialog" Class="mr-2">
            @LangService.GetString("Outcome_EditButton")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" Disabled="@(_selectedItem == null)" OnClick="DeleteAsync">
            @LangService.GetString("Outcome_DeleteButton")
        </MudButton>
    </MudPaper>
</MudContainer>

<style>
    .selected-row {
        background-color: rgba(33, 150, 243, 0.2) !important;
    }
</style>

@code {
    private List<OtherOutcomeModel> _items = new();
    private OtherOutcomeModel? _selectedItem;
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += StateHasChanged;
        await LoadDataAsync();
    }

    public void Dispose() => LangService.OnLanguageChanged -= StateHasChanged;

    private async Task LoadDataAsync()
    {
        try
        {
            _items = await Http.GetFromJsonAsync<List<OtherOutcomeModel>>("rest/v1/other_outcomes?select=*&order=expense_date.desc") ?? new();
            _selectedItem = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private string SelectedRowClassFunc(OtherOutcomeModel item, int rowNumber) => _selectedItem?.id == item.id ? "selected-row" : string.Empty;

    private bool FilterFunc(OtherOutcomeModel item)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        return item.description.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
               item.payment_method.Contains(_searchString, StringComparison.OrdinalIgnoreCase);
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters { ["Model"] = new OtherOutcomeModel(), ["IsNew"] = true };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<OtherOutcomeDialog>(LangService.GetString("Outcome_AddTitle"), parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadDataAsync();
    }

    private async Task OpenEditDialog()
    {
        if (_selectedItem == null) return;
        var editModel = new OtherOutcomeModel
        {
            id = _selectedItem.id,
            owner_id = _selectedItem.owner_id,
            staff_id = _selectedItem.staff_id,
            description = _selectedItem.description,
            amount = _selectedItem.amount,
            payment_method = _selectedItem.payment_method,
            expense_date = _selectedItem.expense_date,
            note = _selectedItem.note
        };
        var parameters = new DialogParameters { ["Model"] = editModel, ["IsNew"] = false };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<OtherOutcomeDialog>(LangService.GetString("Outcome_EditTitle"), parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadDataAsync();
    }

    private async Task DeleteAsync()
    {
        if (_selectedItem == null) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            LangService.GetString("Confirm_Title"), LangService.GetString("Confirm_DeleteMessage"),
            yesText: LangService.GetString("Btn_Yes"), cancelText: LangService.GetString("Btn_Cancel"));

        if (confirmed == true)
        {
            try
            {
                // 1. Transaction ကို Description နှင့် Type (Expense) ဖြင့် ရှာဖွေခြင်း
                var transactions = await Http.GetFromJsonAsync<List<TransactionLookupModel>>(
                    $"rest/v1/transactions?description=eq.{_selectedItem.description}&transaction_type=eq.Expense&select=id,wallet_id,total_amount");

                if (transactions != null && transactions.Any())
                {
                    foreach (var tx in transactions)
                    {
                        // 2. Wallet ထဲသို့ ငွေကို ပြန်ထည့်ခြင်း (ထွက်ငွေဖြစ်သောကြောင့် ဖျက်လျှင် ငွေပြန်တိုးလာမည်)
                        if (!string.IsNullOrEmpty(tx.wallet_id) && tx.total_amount > 0)
                        {
                            var wallets = await Http.GetFromJsonAsync<List<WalletFullModel>>($"rest/v1/wallets?id=eq.{tx.wallet_id}&select=balance");
                            if (wallets != null && wallets.Any())
                            {
                                decimal restoredBal = wallets.First().balance + tx.total_amount;
                                await Http.PatchAsJsonAsync($"rest/v1/wallets?id=eq.{tx.wallet_id}", new { balance = restoredBal });
                            }
                        }
                        // 3. ဆက်စပ် ဇယားများမှ ဖျက်ခြင်း
                        await Http.DeleteAsync($"rest/v1/ledgers?transaction_id=eq.{tx.id}");
                        await Http.DeleteAsync($"rest/v1/vouchers?reference_id=eq.{tx.id}");
                        await Http.DeleteAsync($"rest/v1/transactions?id=eq.{tx.id}");
                    }
                }

                // 4. Other Outcomes ဇယားမှ ဖျက်ခြင်း
                var response = await Http.DeleteAsync($"rest/v1/other_outcomes?id=eq.{_selectedItem.id}");
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add(LangService.GetString("Outcome_DeleteSuccess") ?? "အောင်မြင်စွာဖျက်သိမ်းပြီးပါပြီ", Severity.Success);
                    await LoadDataAsync();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Delete Error: {ex.Message}", Severity.Error);
            }
        }
    }

    public class OtherOutcomeModel
    {
        public string id { get; set; } = string.Empty;
        public string owner_id { get; set; } = string.Empty;
        public string? staff_id { get; set; }
        public string description { get; set; } = string.Empty;
        public decimal amount { get; set; }
        public string payment_method { get; set; } = string.Empty;
        public DateTime expense_date { get; set; } = DateTime.Today;
        public string? note { get; set; }
    }

    private class TransactionLookupModel { public string id { get; set; } = string.Empty; public string? wallet_id { get; set; } public decimal total_amount { get; set; } }
    private class WalletFullModel { public string id { get; set; } = string.Empty; public decimal balance { get; set; } }
}