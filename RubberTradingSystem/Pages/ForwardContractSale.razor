@page "/forward-contract/sale"
@using MudBlazor
@using RubberTradingSystem.Models
@using RubberTradingSystem.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject LanguageService LangService
@inject UserContextService UserContext
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-6">

    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">
            @LangService.GetString("Title_ForwardContractSale") (ရာဘာပေးသွင်းခြင်း)
        </MudText>
        <!-- ဘောင်ချာအမှတ်စဉ် -->
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
            <b>Voucher: @_currentVoucherNumber</b>
        </MudChip>
    </div>

    <MudPaper Class="pa-6" Elevation="3">
        <EditForm Model="@_model" OnValidSubmit="HandleValidSubmitAsync">
            <DataAnnotationsValidator />

            <MudGrid Spacing="3">
                <!-- 1. အလုပ်လုပ်မည့် Active ဖြစ်နေသော ကြိုပွိုင့်စာချုပ်ကို ရွေးချယ်ခြင်း -->
                <MudItem xs="12">
                    <MudSelect T="string" Value="@_model.forward_contract_id" ValueChanged="OnContractSelected" Label="@LangService.GetString("Lbl_SelectActiveContract")"
                               Variant="Variant.Outlined" Dense="true" Required="true" Clearable="true"
                               Disabled="_isSuccessCompleted">
                        @if (_activeContracts != null)
                        {
                            @foreach (var c in _activeContracts)
                            {
                                <MudSelectItem Value="@c.Id">@c.MerchantName - ချုပ်ဆိုပိဿာ: @c.ContractQuantity.ToString("N2") | သွင်းပြီး: @c.DeliveredQuantity.ToString("N2") | လက်ကျန်: @c.RemainingQuantity.ToString("N2")</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>

                <!-- ရွေးချယ်ထားသော စာချုပ်အချက်အလက် အကျဉ်းချုပ်ပြရန် -->
                @if (_selectedContractDetails != null)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true">
                            <b>ကုန်သည်:</b> @_selectedContractDetails.MerchantName |
                            <b>သဘောတူဈေး (Contract Price):</b> @_selectedContractDetails.agreed_price.ToString("N0") @_currencySymbol |
                            <b>ပေးသွင်းရန် လက်ကျန်ပိဿာ:</b> @_selectedContractDetails.RemainingQuantity.ToString("N2") @_weightUnit
                        </MudAlert>
                    </MudItem>
                }

                <MudDivider Class="my-4" />

                <!-- 2. Stock Source Selection (Warehouse, Truck, Temp) -->
                <MudItem xs="12" md="4">
                    <MudSelect T="string" Value="@_model.source_type" ValueChanged="OnSourceTypeChanged" Label="ရာဘာတည်နေရာ (Source Type)"
                               Variant="Variant.Outlined" Dense="true" Required="true" Disabled="_isSuccessCompleted">
                        <MudSelectItem Value="@("Warehouse")">ဂိုဒေါင် (Warehouse)</MudSelectItem>
                        <MudSelectItem Value="@("TruckStock")">ကားစတော့ခ် (Truck Stock)</MudSelectItem>
                        <MudSelectItem Value="@("TempStock")">ယာယီစတော့ခ် (Temp Stock)</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudSelect T="string" Value="@_model.source_id" ValueChanged="OnSourceItemChanged"
                               Label="ပေးသွင်းမည့် ရာဘာကို ရွေးချယ်ပါ (Select Rubber Stock)" Variant="Variant.Outlined" Dense="true" Required="true" Clearable="true"
                               Disabled="_isSuccessCompleted">
                        @if (_sourceItems != null && _sourceItems.Any())
                        {
                            @foreach (var item in _sourceItems)
                            {
                                <MudSelectItem Value="@item.Id">@item.DisplayName</MudSelectItem>
                            }
                        }
                        else if (_selectedContractDetails != null)
                        {
                            <MudSelectItem Value="@(string.Empty)" Disabled="true">သက်ဆိုင်ရာ ရာဘာအမျိုးအစား Stock မရှိပါ</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- 3. Available Quantity & Weight -->
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Value="@_availableQuantity.ToString("N2")" ReadOnly="true" Disabled="true"
                                  Label="@($"လက်ကျန်ပမာဏ (Available Quantity - {_weightUnit})")" Variant="Variant.Outlined" Dense="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal" @bind-Value="_model.weight" Immediate="true" Format="N2"
                                     Label="@($"ပေးသွင်းမည့်ပမာဏ (Deliver Weight - {_weightUnit})")" Variant="Variant.Outlined" Dense="true" Min="0" HideSpinButtons="true" Disabled="_isSuccessCompleted" />
                </MudItem>

                <!-- 4. မှတ်ချက် -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.description" Label="@LangService.GetString("Lbl_Note")" Variant="Variant.Outlined" Dense="true" Lines="2" Disabled="_isSuccessCompleted" />
                </MudItem>
            </MudGrid>

            <!-- BUTTONS -->
            <div class="d-flex justify-end gap-3 mt-6">
                @if (!_isSuccessCompleted)
                {
                    <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="px-6"
                               Disabled="@_isSaving" OnClick="HandleValidSubmitAsync">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            <text>@LangService.GetString("Sale_SaveButton")</text>
                        }
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="true" Size="Size.Large" Class="px-6">
                        @LangService.GetString("Sale_SaveButton")
                    </MudButton>
                }

                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Large" OnClick="PrintVoucher"
                           Disabled="!_isSuccessCompleted">
                    @LangService.GetString("Btn_PrintVoucher")
                </MudButton>

                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" OnClick="FinishTransaction"
                           Disabled="!_isSuccessCompleted" Class="px-6">
                    @LangService.GetString("Btn_Finish")
                </MudButton>
            </div>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private string _currentVoucherNumber = string.Empty;
    private bool _isSaving = false;
    private bool _isSuccessCompleted = false;

    private ForwardContractSaleModel _model = new();
    private List<ActiveContractItem> _activeContracts = new();
    private ActiveContractItem? _selectedContractDetails;

    private List<StockSourceItem> _sourceItems = new();
    private decimal _availableQuantity = 0m;

    private string _weightUnit = "ပိဿာ";
    private string _currencySymbol = "MMK";

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += StateHasChanged;
        await LoadSettingsAsync();
        await LoadInitialDataAsync();
    }

    public void Dispose() => LangService.OnLanguageChanged -= StateHasChanged;

    private async Task LoadSettingsAsync()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<List<BusinessSettingModel>>("rest/v1/business_settings?select=*");
            if (settings != null && settings.Any())
            {
                var s = settings.First();
                _weightUnit = s.default_weight_unit;
                _currencySymbol = s.currency_symbol;
            }
        }
        catch { }
    }

    private async Task LoadInitialDataAsync()
    {
        try
        {
            // Active ဖြစ်နေသော ကြိုပွိုင့်စာချုပ်များကို ဆွဲထုတ်ခြင်း
            var rawContracts = await Http.GetFromJsonAsync<List<ForwardContractRawModel>>("rest/v1/forward_contracts?status=eq.Active&select=id,contact_id,contract_quantity,delivered_quantity,agreed_price,rubber_type_id,contacts(name)") ?? new();

            _activeContracts = rawContracts.Select(x => new ActiveContractItem
            {
                Id = x.id,
                MerchantId = x.contact_id ?? "",
                MerchantName = x.contacts?.name ?? "N/A",
                ContractQuantity = x.contract_quantity,
                DeliveredQuantity = x.delivered_quantity,
                agreed_price = x.agreed_price,
                rubber_type_id = x.rubber_type_id ?? ""
            }).ToList();

            _currentVoucherNumber = await GenerateVoucherNumberAsync("FCSALE");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnContractSelected(string value)
    {
        _model.forward_contract_id = value;
        _selectedContractDetails = _activeContracts.FirstOrDefault(c => c.Id == value);

        _model.weight = 0m;

        await LoadSourceItemsAsync();
    }

    private async Task OnSourceTypeChanged(string value)
    {
        _model.source_type = value;
        await LoadSourceItemsAsync();
    }

    private void OnSourceItemChanged(string value)
    {
        _model.source_id = value;
        var matchedItem = _sourceItems.FirstOrDefault(s => s.Id == value);
        _availableQuantity = matchedItem?.AvailableQuantity ?? 0m;
    }

    private async Task LoadSourceItemsAsync()
    {
        _sourceItems.Clear();
        _availableQuantity = 0m;
        _model.source_id = string.Empty;

        if (_selectedContractDetails == null) return;

        string targetRubberTypeId = _selectedContractDetails.rubber_type_id;

        try
        {
            if (_model.source_type == "Warehouse")
            {
                var batches = await Http.GetFromJsonAsync<List<WarehouseBatchStockModel>>($"rest/v1/warehouse_batches?status=eq.Active&rubber_type_id=eq.{targetRubberTypeId}&select=id,batch_number,total_weight,rubber_type_id") ?? new();
                foreach (var b in batches)
                {
                    _sourceItems.Add(new StockSourceItem { Id = b.id, DisplayName = $"Batch: {b.batch_number}", AvailableQuantity = b.total_weight, RubberTypeId = b.rubber_type_id });
                }
            }
            else if (_model.source_type == "TruckStock")
            {
                var trucks = await Http.GetFromJsonAsync<List<TruckStockModel>>($"rest/v1/truck_stocks?status=eq.Active&rubber_type_id=eq.{targetRubberTypeId}&select=id,quantity,rubber_type_id,vehicle_id") ?? new();
                foreach (var t in trucks)
                {
                    _sourceItems.Add(new StockSourceItem { Id = t.id, DisplayName = $"Truck ID: {t.vehicle_id}", AvailableQuantity = t.quantity, RubberTypeId = t.rubber_type_id });
                }
            }
            else if (_model.source_type == "TempStock")
            {
                var temps = await Http.GetFromJsonAsync<List<TempStockModel>>($"rest/v1/temp_stocks?status=eq.Pending&rubber_type_id=eq.{targetRubberTypeId}&select=id,net_weight,rubber_type_id,source_type") ?? new();
                foreach (var tp in temps)
                {
                    _sourceItems.Add(new StockSourceItem { Id = tp.id, DisplayName = $"Temp Stock ({tp.source_type})", AvailableQuantity = tp.net_weight, RubberTypeId = tp.rubber_type_id });
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading stock source: {ex.Message}", Severity.Warning);
        }
        StateHasChanged();
    }

    private async Task HandleValidSubmitAsync()
    {
        if (string.IsNullOrEmpty(_model.source_id))
        {
            Snackbar.Add("ကျေးဇူးပြု၍ ပေးသွင်းမည့် ရာဘာ Stock ကို ရွေးချယ်ပါ။", Severity.Warning);
            return;
        }

        if (_model.weight <= 0)
        {
            Snackbar.Add("ပေးသွင်းမည့် ပိဿာချိန် မှားယွင်းနေပါသည်။", Severity.Warning);
            return;
        }

        if (_model.weight > _availableQuantity)
        {
            Snackbar.Add("ပေးသွင်းမည့် ပိဿာချိန်သည် ရွေးချယ်ထားသော Stock လက်ကျန်ထက် ကျော်လွန်နေပါသည်။", Severity.Warning);
            return;
        }

        if (_selectedContractDetails != null && _model.weight > _selectedContractDetails.RemainingQuantity)
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                "Warning",
                "လာသွင်းသည့် ပိဿာချိန်သည် စာချုပ်လက်ကျန်ထက် ကျော်လွန်နေပါသည်။ ဆက်လုပ်ရန် သေချာပါသလား?",
                yesText: "သေချာပါသည်", cancelText: "မလုပ်ပါ");

            if (confirmed != true) return;
        }

        await SaveSaleAsync();
    }

    private async Task SaveSaleAsync()
    {
        _isSaving = true;
        try
        {
            var ownerId = await UserContext.GetCurrentOwnerIdAsync();
            var staffId = await UserContext.GetCurrentStaffIdAsync();

            if (_selectedContractDetails == null) return;

            // စာချုပ်စျေးနှုန်းနှင့် ပေးသွင်းသည့်ပမာဏ မြှောက်ပြီး Record အဖြစ်သာ မှတ်ရန်
            decimal calculatedTotalAmount = _model.weight * _selectedContractDetails.agreed_price;

            // 1. Transactions ဇယားတွင် Forward Contract Sale အဖြစ် မှတ်တမ်းတင်ခြင်း
            var txPayload = new
            {
                owner_id = ownerId,
                staff_id = staffId,
                contact_id = _selectedContractDetails.MerchantId,
                rubber_type_id = _selectedContractDetails.rubber_type_id,
                transaction_type = "ForwardContractSale",
                wallet_id = (string?)null, // ငွေလက်ခံခြင်း မရှိပါ
                total_amount = calculatedTotalAmount,
                agreed_price = _selectedContractDetails.agreed_price,
                quantity = _model.weight,
                paid_amount = 0, // ငွေလက်ခံခြင်း မရှိပါ
                voucher_number = _currentVoucherNumber,
                description = string.IsNullOrEmpty(_model.description) ? $"ကြိုပွိုင့် ရာဘာပေးသွင်းခြင်း (Source: {_model.source_type}, Voucher: {_currentVoucherNumber})" : _model.description,
                sync_status = "Synced"
            };

            var reqMsg = new HttpRequestMessage(HttpMethod.Post, "rest/v1/transactions")
            {
                Content = JsonContent.Create(txPayload)
            };
            reqMsg.Headers.Add("Prefer", "return=representation");
            var txResp = await Http.SendAsync(reqMsg);

            if (txResp.IsSuccessStatusCode)
            {
                var createdTx = await txResp.Content.ReadFromJsonAsync<List<TransactionResponseModel>>();
                string? txId = createdTx?.FirstOrDefault()?.id;

                // 2. Vouchers ဇယားတွင် မှတ်တမ်းတင်ခြင်း
                var voucherPayload = new
                {
                    owner_id = ownerId,
                    staff_id = staffId,
                    voucher_number = _currentVoucherNumber,
                    voucher_type = "ForwardContractSale",
                    reference_id = txId
                };
                await Http.PostAsJsonAsync("rest/v1/vouchers", voucherPayload);

                // 3. Ledger ဇယားတွင် မှတ်တမ်းတင်ခြင်း (ဝယ်သူပေးထားသော Advance ထဲမှ ရာဘာဖိုး ပြန်နှုတ်ခြင်းသဘော Debit သာမှတ်မည်)
                if (!string.IsNullOrEmpty(_selectedContractDetails.MerchantId))
                {
                    decimal prevBal = await GetLatestBalanceForContactAsync(_selectedContractDetails.MerchantId);
                    decimal debitVal = calculatedTotalAmount; // ရာဘာဖိုး
                    decimal creditVal = 0m;
                    decimal currentRunningBalance = prevBal + debitVal - creditVal;

                    var ledgerPayload = new
                    {
                        owner_id = ownerId,
                        staff_id = string.IsNullOrEmpty(staffId) ? null : staffId,
                        contact_id = _selectedContractDetails.MerchantId,
                        transaction_id = txId,
                        voucher_number = _currentVoucherNumber,
                        entry_type = "Debit",
                        debit_amount = debitVal,
                        credit_amount = creditVal,
                        balance_after = currentRunningBalance,
                        balance_impact = "Increase", // Receivable balance တိုးမည် (Advance လျော့မည်)
                        ref_type = "ForwardContractSale",
                        description = $"ကြိုပွိုင့် ရာဘာပေးသွင်းခြင်း (ပိဿာ: {_model.weight.ToString("N2")}) Voucher {_currentVoucherNumber}"
                    };
                    await Http.PostAsJsonAsync("rest/v1/ledgers", ledgerPayload);

                    // Contact ဇယားကိုပါ Update ပြုလုပ်ရန်
                    await Http.PatchAsJsonAsync($"rest/v1/contacts?id=eq.{_selectedContractDetails.MerchantId}", new { receivable_balance = currentRunningBalance });
                }

                // 4. Stock ဇယားများမှ အမှန်တကယ် လက်ကျန်နှုတ်ခြင်း
                await DeductStockSourceAsync();

                // 5. Forward Contract ဇယားရှိ delivered_quantity ကို ပေါင်းထည့်ပြီး status ကို ချိန်ညှိခြင်း
                decimal newDeliveredQty = _selectedContractDetails.DeliveredQuantity + _model.weight;
                string newStatus = newDeliveredQty >= _selectedContractDetails.ContractQuantity ? "Completed" : "Active";

                await Http.PatchAsync($"rest/v1/forward_contracts?id=eq.{_selectedContractDetails.Id}", JsonContent.Create(new
                {
                    delivered_quantity = newDeliveredQty,
                    status = newStatus
                }));

                Snackbar.Add("ရာဘာပေးသွင်းမှု အောင်မြင်စွာ သိမ်းဆည်းပြီးပါပြီ။", Severity.Success);
                _isSuccessCompleted = true;
            }
            else
            {
                var err = await txResp.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to save transaction: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeductStockSourceAsync()
    {
        if (_model.source_type == "Warehouse")
        {
            var batch = await Http.GetFromJsonAsync<List<WarehouseBatchStockModel>>($"rest/v1/warehouse_batches?id=eq.{_model.source_id}&select=total_weight");
            if (batch != null && batch.Any())
            {
                decimal currentWeight = batch.First().total_weight;
                decimal remainingWeight = Math.Max(0m, currentWeight - _model.weight);
                string newStatus = remainingWeight <= 0 ? "Completed" : "Active";

                await Http.PatchAsync($"rest/v1/warehouse_batches?id=eq.{_model.source_id}",
                    JsonContent.Create(new { total_weight = remainingWeight, status = newStatus }));
            }
        }
        else if (_model.source_type == "TruckStock")
        {
            var truck = await Http.GetFromJsonAsync<List<TruckStockModel>>($"rest/v1/truck_stocks?id=eq.{_model.source_id}&select=quantity");
            if (truck != null && truck.Any())
            {
                decimal currentQty = truck.First().quantity;
                decimal remainingQty = Math.Max(0m, currentQty - _model.weight);
                string newStatus = remainingQty <= 0 ? "Completed" : "Active";

                await Http.PatchAsync($"rest/v1/truck_stocks?id=eq.{_model.source_id}",
                    JsonContent.Create(new { quantity = remainingQty, status = newStatus }));
            }
        }
        else if (_model.source_type == "TempStock")
        {
            var temp = await Http.GetFromJsonAsync<List<TempStockModel>>($"rest/v1/temp_stocks?id=eq.{_model.source_id}&select=net_weight");
            if (temp != null && temp.Any())
            {
                decimal currentWeight = temp.First().net_weight;
                decimal remainingWeight = Math.Max(0m, currentWeight - _model.weight);
                string newStatus = remainingWeight <= 0 ? "Completed" : "Pending";

                await Http.PatchAsync($"rest/v1/temp_stocks?id=eq.{_model.source_id}",
                    JsonContent.Create(new { net_weight = remainingWeight, status = newStatus }));
            }
        }
    }

    private async Task<decimal> GetLatestBalanceForContactAsync(string contactId)
    {
        try
        {
            var resp = await Http.GetFromJsonAsync<List<LedgerItemModel>>(
                $"rest/v1/ledgers?contact_id=eq.{contactId}&select=balance_after&order=created_at.desc&limit=1");
            if (resp != null && resp.Any()) return resp.First().balance_after;
        }
        catch { }
        return 0m;
    }

    private void PrintVoucher() => Snackbar.Add($"ဘောင်ချာအမှတ် {_currentVoucherNumber} ကို Print ထုတ်နေပါပြီ...", Severity.Info);

    private async Task FinishTransaction()
    {
        _model = new ForwardContractSaleModel();
        _selectedContractDetails = null;
        _availableQuantity = 0m;
        _sourceItems.Clear();
        _isSuccessCompleted = false;
        _isSaving = false;
        _currentVoucherNumber = await GenerateVoucherNumberAsync("FCSALE");
        await LoadInitialDataAsync();
        StateHasChanged();
        Snackbar.Add("ဘောင်ချာအသစ်သို့ ပြောင်းလဲပြီးပါပြီ။", Severity.Info);
    }

    private async Task<string> GenerateVoucherNumberAsync(string prefix)
    {
        string dateStr = DateTime.Now.ToString("yyyyMMdd");
        string searchPattern = $"{prefix}-{dateStr}-";
        try
        {
            var transactions = await Http.GetFromJsonAsync<List<TransactionResponseModel>>(
                $"rest/v1/transactions?voucher_number=like.{searchPattern}*&select=voucher_number");
            int nextSeq = 1;
            if (transactions != null && transactions.Any())
            {
                var maxSeq = transactions
                    .Where(t => !string.IsNullOrEmpty(t.voucher_number) && t.voucher_number.Contains("-"))
                    .Select(t =>
                    {
                        string part = t.voucher_number!.Substring(t.voucher_number.LastIndexOf('-') + 1);
                        return int.TryParse(part, out int val) ? val : 0;
                    })
                    .DefaultIfEmpty(0)
                    .Max();
                nextSeq = maxSeq + 1;
            }
            return $"{prefix}-{dateStr}-{nextSeq:D3}";
        }
        catch
        {
            return $"{prefix}-{dateStr}-001";
