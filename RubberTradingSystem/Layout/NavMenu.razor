@using RubberTradingSystem.Services
@inject LanguageService LangService
@implements IDisposable

<MudNavMenu Class="pa-2">
    <div class="pa-3 text-center">
        <!-- Logo ပုံလေး -->
        <MudIcon Icon="@Icons.Material.Filled.Agriculture" Color="Color.Primary" Size="Size.Large" />
        <MudText Color="Color.Primary">Rubber Trading System</MudText>
    </div>

    <MudDivider Class="my-2" />
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Primary">
        <b>@LangService.GetString("Dashboard")</b>
    </MudNavLink>

    <MudNavGroup Title="@LangService.GetString("Menu_Trading")" Icon="@Icons.Material.Filled.Storefront">
        <MudNavLink Href="/rubber-purchase" Icon="@Icons.Material.Filled.ShoppingCart">@LangService.GetString("Menu_Purchase")</MudNavLink>
        <MudNavLink Href="/rubber-purchases-list" Icon="@Icons.Material.Filled.ListAlt">@LangService.GetString("Menu_PurchaseList")</MudNavLink>
        <MudNavLink Href="/rubber-sales" Icon="@Icons.Material.Filled.Sell">@LangService.GetString("Menu_Sales")</MudNavLink>
        <MudNavLink Href="/rubber-sales-list" Icon="@Icons.Material.Filled.ListAlt" Match="NavLinkMatch.Prefix">
            @LangService.GetString("Sale_ListTitle")
        </MudNavLink>
        <MudNavLink Href="/warehouse/transfer" Icon="@Icons.Material.Filled.Warehouse" Match="NavLinkMatch.Prefix">
            @LangService.GetString("Menu_WarehouseTransfer")
        </MudNavLink>
        <MudNavLink Href="/daily-prices" Icon="@Icons.Material.Filled.PriceChange">@LangService.GetString("Menu_Pricing")</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@LangService.GetString("Menu_Production")" Icon="@Icons.Material.Filled.Factory">
        <MudNavLink Href="/rubber-smoking" Icon="@Icons.Material.Filled.PrecisionManufacturing">@LangService.GetString("Menu_Milling")</MudNavLink>
        <MudNavLink Href="/rubber-smoking/analytics" Icon="@Icons.Material.Filled.Analytics">
            @LangService.GetString("Menu_SmokingAnalytics")
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@LangService.GetString("Menu_WMS")" Icon="@Icons.Material.Filled.Warehouse">
        <MudNavLink Href="/stock-balance" Icon="@Icons.Material.Filled.Inventory2" Match="NavLinkMatch.Prefix">
            @LangService.GetString("Menu_StockBalance")
        </MudNavLink>
        <MudNavLink Href="/stock-transfers" Icon="@Icons.Material.Filled.LocalShipping">@LangService.GetString("Menu_StockTransfer")</MudNavLink>
        <MudNavLink Href="/stock-adjustments" Icon="@Icons.Material.Filled.Balance">@LangService.GetString("Menu_StockAdj")</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@LangService.GetString("Menu_Finance")" Icon="@Icons.Material.Filled.AccountBalanceWallet">
        <MudNavLink Href="/expenses" Icon="@Icons.Material.Filled.MoneyOff">@LangService.GetString("Menu_Expenses")</MudNavLink>

        <MudNavLink Href="/other-incomes" Icon="@Icons.Material.Filled.AttachMoney">@LangService.GetString("Menu_Incomes")</MudNavLink>

        <MudNavLink Href="/other-outcomes" Icon="@Icons.Material.Filled.Payments">@LangService.GetString("Menu_OtherOutcomes")</MudNavLink>

        <MudNavLink Href="/wallets" Icon="@Icons.Material.Filled.AccountBalance">@LangService.GetString("Menu_Wallets")</MudNavLink>
        <MudNavLink Href="/fund-transfers" Icon="@Icons.Material.Filled.SwapHoriz">@LangService.GetString("Menu_Transfers")</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@LangService.GetString("Menu_Contacts")" Icon="@Icons.Material.Filled.Contacts">
        <MudNavLink Href="/contacts" Icon="@Icons.Material.Filled.ContactPage">
            @LangService.GetString("Menu_Contacts")
        </MudNavLink>
       
        <!-- ခြံရှင် (Supplier) Advance များ -->
        <MudNavLink Href="/advance/out" Icon="@Icons.Material.Filled.CreditScore">@LangService.GetString("Menu_Advances")</MudNavLink>
        <MudNavLink Href="/advance/in" Icon="@Icons.Material.Filled.CurrencyExchange">@LangService.GetString("Menu_Repayments")</MudNavLink>

        <!-- ကုန်သည် (Buyer) Advance များနှင့် ပြန်ဆပ်ခြင်းများ -->
        <MudNavLink Href="/advance/buyer-out" Icon="@Icons.Material.Filled.RequestQuote">@LangService.GetString("Menu_BuyerAdvanceOut")</MudNavLink>
        <MudNavLink Href="/advance/buyer-in" Icon="@Icons.Material.Filled.Payments">@LangService.GetString("Menu_BuyerAdvanceIn")</MudNavLink>

        <MudNavLink Href="/farm-accounts" Icon="@Icons.Material.Filled.AccountBalance" Match="NavLinkMatch.All">
            @LangService.GetString("Nav_FarmAccounts")
        </MudNavLink>
       
        <!-- ခြံရှင်များ ကြိုတင်ထုတ်ယူငွေမှတ်တမ်း (Farm Owner Advances) -->
        <MudNavLink Href="/farm-owner-advances" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountBalanceWallet">
            @LangService.GetString("Menu_FarmOwnerAdvances")
        </MudNavLink>

        <!-- ခြံရှင်များ ကြိုတင်ငွေပြန်ဆပ်ခြင်းမှတ်တမ်း (Farm Owner Repayments) -->
        <MudNavLink Href="/farm-owner-repayments" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Payment">
            @LangService.GetString("Menu_FarmOwnerRepayments")
        </MudNavLink>
        <MudNavLink Href="/receivables-payables" Icon="@Icons.Material.Filled.Balance" Match="NavLinkMatch.Prefix">
            @LangService.GetString("Menu_BalanceSummary")
        </MudNavLink>
    </MudNavGroup>

    <!-- ကြိုပွိုင့် (Forward Contract) အုပ်စု -->
    <MudNavGroup Title="@LangService.GetString("Menu_ForwardContract")" Icon="@Icons.Material.Filled.Assignment">
        <MudNavLink Href="/forward-contract/create" Icon="@Icons.Material.Filled.NoteAdd">
            @LangService.GetString("Menu_CreateContract")
        </MudNavLink>
        <MudNavLink Href="/forward-contract/list" Icon="@Icons.Material.Filled.ListAlt">
            @LangService.GetString("Menu_ContractList")
        </MudNavLink>
        <MudNavLink Href="/forward-contract/sale" Icon="@Icons.Material.Filled.Sell">
            @LangService.GetString("Menu_ContractSale")
        </MudNavLink>
        <MudNavLink Href="/forward-contract/deliver" Icon="@Icons.Material.Filled.LocalShipping">
            @LangService.GetString("Menu_ContractDelivery")
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@LangService.GetString("Menu_Logistics")" Icon="@Icons.Material.Filled.LocalShipping">
        <MudNavLink Href="/truck-stock" Icon="@Icons.Material.Filled.DirectionsCar">@LangService.GetString("Menu_Vehicles")</MudNavLink>
        <MudNavLink Href="/truck-expenses" Icon="@Icons.Material.Filled.LocalGasStation">@LangService.GetString("Menu_Fuel")</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@LangService.GetString("Menu_HR")" Icon="@Icons.Material.Filled.PeopleAlt">
        <MudNavLink Href="/staff" Icon="@Icons.Material.Filled.Badge">@LangService.GetString("Menu_Staff")</MudNavLink>
        <MudNavLink Href="/attendance" Icon="@Icons.Material.Filled.EventAvailable">@LangService.GetString("Menu_Attendance")</MudNavLink>
        <MudNavLink Href="/payroll" Icon="@Icons.Material.Filled.Payments">@LangService.GetString("Menu_Payroll")</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@LangService.GetString("Menu_Assets")" Icon="@Icons.Material.Filled.Domain">
        <MudNavLink Href="/process" Icon="@Icons.Material.Filled.Chair">@LangService.GetString("Menu_AssetList")</MudNavLink>
        <MudNavLink Href="/process" Icon="@Icons.Material.Filled.TrendingDown">@LangService.GetString("Menu_Depreciation")</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@LangService.GetString("Menu_Reports")" Icon="@Icons.Material.Filled.BarChart">
        <MudNavLink Href="/reports/purchases" Icon="@Icons.Material.Filled.ShoppingCart">
            @LangService.GetString("Menu_PurchaseReport")
        </MudNavLink>
        <MudNavLink Href="/reports/sales" Icon="@Icons.Material.Filled.Sell">
            @LangService.GetString("Menu_SaleReport")
        </MudNavLink>
        <MudNavLink Href="/reports/forward-contract-sales" Icon="@Icons.Material.Filled.AssignmentReturned">
            @LangService.GetString("Menu_FCContractSaleReport")
        </MudNavLink>
        <MudNavLink Href="/reports/supplier-advances" Icon="@Icons.Material.Filled.AccountBalanceWallet">
            @LangService.GetString("Menu_SupplierAdvanceReport")
        </MudNavLink>
        <MudNavLink Href="/reports/supplier-repayments" Icon="@Icons.Material.Filled.Payment">
            @LangService.GetString("Menu_SupplierRepaymentReport")
        </MudNavLink>
        <MudNavLink Href="/reports/buyer-advances" Icon="@Icons.Material.Filled.RequestQuote">
            @LangService.GetString("Menu_BuyerAdvanceReport")
        </MudNavLink>
        <MudNavLink Href="/reports/buyer-repayments" Icon="@Icons.Material.Filled.MoneyOff">
            @LangService.GetString("Menu_BuyerRepaymentReport")
        </MudNavLink>
        <MudNavLink Href="/reports/forward-contracts" Icon="@Icons.Material.Filled.Description">
            @LangService.GetString("Menu_ForwardContractReport")
        </MudNavLink>
        <MudNavLink Href="/reports/expenses" Icon="@Icons.Material.Filled.ReceiptLong">
            @LangService.GetString("Menu_ExpenseReport")
        </MudNavLink>
        <MudNavLink Href="/reports/truck-expenses" Icon="@Icons.Material.Filled.LocalShipping">
            @LangService.GetString("Menu_TruckExpenseReport")
        </MudNavLink>
        <MudNavLink Href="/reports/executive-dashboard" Icon="@Icons.Material.Filled.Dashboard">@LangService.GetString("Menu_Dashboard")</MudNavLink>
        <MudNavLink Href="/reports/supplier-balance" Icon="@Icons.Material.Filled.AccountBalanceWallet">@LangService.GetString("Menu_SupplierBalance")</MudNavLink>
        <MudNavLink Href="/reports/buyer-contract-status" Icon="@Icons.Material.Filled.Assignment">@LangService.GetString("Menu_BuyerContractStatus")</MudNavLink>
        <MudNavLink Href="/reports/rubber-grade-summary" Icon="@Icons.Material.Filled.Category">@LangService.GetString("Menu_RubberGradeSummary")</MudNavLink>
        <MudNavLink Href="/reports/wallet-ledger" Icon="@Icons.Material.Filled.AccountBalance">@LangService.GetString("Menu_WalletLedger")</MudNavLink>
        <MudNavLink Href="/reports/profit-loss" Icon="@Icons.Material.Filled.TrendingUp">@LangService.GetString("Menu_ProfitLoss")</MudNavLink>
        <MudNavLink Href="/reports/daily-cash-closing" Icon="@Icons.Material.Filled.AccountBalance">
            @LangService.GetString("Menu_CashClosingReport")
        </MudNavLink>
    </MudNavGroup>

    <MudDivider Class="my-2" />

    <MudNavGroup Title="@LangService.GetString("Menu_Sync")" Icon="@Icons.Material.Filled.CloudSync" IconColor="Color.Warning">
        <MudNavLink Href="/process" Icon="@Icons.Material.Filled.CloudUpload">@LangService.GetString("Menu_Push")</MudNavLink>
    </MudNavGroup>

    <!-- Configuration Section -->
    <MudNavGroup Title="@LangService.GetString("Nav_DataManagement")" Icon="@Icons.Material.Filled.Grass">
        <MudNavLink Href="/rubber-types" Icon="@Icons.Material.Filled.Grass" Match="NavLinkMatch.All">
            @LangService.GetString("Nav_RubberTypes")
        </MudNavLink>
        <MudNavLink Href="/warehouses" Icon="@Icons.Material.Filled.Warehouse" Match="NavLinkMatch.All">
            @LangService.GetString("Wh_ListTitle")
        </MudNavLink>
        <MudNavLink Href="/payment-methods" Icon="@Icons.Material.Filled.Payment" Match="NavLinkMatch.All">
            @LangService.GetString("Nav_PaymentMethods")
        </MudNavLink>
        <MudNavLink Href="/expense-settings" Icon="@Icons.Material.Filled.SettingsApplications" Match="NavLinkMatch.Prefix">
            @LangService.GetString("Menu_ExpenseSettings")
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@LangService.GetString("Menu_Settings")" Icon="@Icons.Material.Filled.Settings">
        <MudNavLink Href="/process" Icon="@Icons.Material.Filled.Palette">@LangService.GetString("Menu_ThemeLang")</MudNavLink>
        <MudNavLink Href="/business-settings" Icon="@Icons.Material.Filled.Rule">@LangService.GetString("Menu_Defaults")</MudNavLink>
        <MudNavLink Href="/settings/printer" Icon="@Icons.Material.Filled.Print">@LangService.GetString("Menu_Print")</MudNavLink>
        <MudNavLink Href="/staff-list" Icon="@Icons.Material.Filled.Security">@LangService.GetString("Menu_Roles")</MudNavLink>
        <MudNavLink Href="/wallets" Icon="@Icons.Material.Filled.CreditCard">
            @LangService.GetString("Payment_ListTitle")
        </MudNavLink>
        <MudNavLink Href="/process" Icon="@Icons.Material.Filled.Policy">@LangService.GetString("Menu_Audit")</MudNavLink>
        <MudNavLink Href="/process" Icon="@Icons.Material.Filled.Save">@LangService.GetString("Menu_Backup")</MudNavLink>
    </MudNavGroup>
</MudNavMenu>

@code {
    private void UpdateUI() => InvokeAsync(StateHasChanged);

    protected override void OnInitialized() => LangService.OnLanguageChanged += UpdateUI;
    public void Dispose() => LangService.OnLanguageChanged -= UpdateUI;
}